#!/usr/bin/env bash
# Single entry point for building, testing, and running Workouts. Quiet on success, focused on failure.
set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

DEV_SIM="${DEV_SIM:-iPhone Duo}"
SCHEME="Workouts"
BUNDLE_ID="com.ericribeiro.Workouts"
DERIVED=".build/DerivedData"
RESULTS=".build/results"
LOGS=".build/logs"
KIT="Packages/WorkoutsKit"
LINT_PATHS=(Workouts WorkoutsLiveActivity Shared WorkoutsTests WorkoutsUITests Packages)
NOISE='IDERunDestination|IDESchemeActionDeviceRecord|IDETestOperationsObserverDebug'
MAX_LINES=80

die() { echo "dev: $*" >&2; exit 1; }

# Print at most MAX_LINES of stdin, noting truncation.
cap() {
  awk -v max="$MAX_LINES" 'NR <= max { print } NR == max + 1 { print "... (truncated)" }'
}

# Run a command, logging combined output to $LOGS/$1.log (noise filtered, or xcbeautify if present).
# Prints nothing on success; on failure prints an error excerpt and returns the command's exit code.
# Logs and result bundles carry the PID so parallel workers running the same command do not clobber each other.
run_logged() {
  local name="$1"; shift
  local log="$LOGS/$name-$$.log" rc
  mkdir -p "$LOGS"
  find "$LOGS" -name '*.log' -mmin +240 -delete 2>/dev/null || true
  LAST_LOG="$log"
  set +e
  if command -v xcbeautify >/dev/null 2>&1; then
    "$@" 2>&1 | xcbeautify --quiet >"$log"
  else
    "$@" 2>&1 | { grep -Ev "$NOISE" || true; } >"$log"
  fi
  rc=${PIPESTATUS[0]}
  set -e
  if ((rc != 0)); then
    echo "FAILED: $name (exit $rc), full log: $log" >&2
    excerpt "$log" | cap >&2
  fi
  return "$rc"
}

# Pull the interesting lines from a log: errors first, otherwise the tail.
excerpt() {
  local log="$1"
  if grep -qE '(error:|error\b.*:|\*\* .* FAILED|✖|❌|Test .* failed|Issue recorded)' "$log"; then
    grep -E '(error:|\*\* .* FAILED|✖|❌|Test .* failed|Issue recorded)' "$log" | awk '!seen[$0]++'
  else
    tail -n 40 "$log"
  fi
}

xcb() { # xcb <action> [extra xcodebuild args...]
  local action="$1"; shift
  xcodebuild "$action" -scheme "$SCHEME" -destination "platform=iOS Simulator,name=$DEV_SIM" \
    -derivedDataPath "$DERIVED" -quiet "$@"
}

# Reduce an xcresult bundle to its failing tests.
report_failures() {
  local bundle="$1"
  [[ -d "$bundle" ]] || return 0
  local json
  json=$(xcrun xcresulttool get test-results summary --path "$bundle" --compact 2>/dev/null) || return 0
  if command -v jq >/dev/null 2>&1; then
    # No failures listed means the build died before any test ran; the log excerpt already said why.
    [[ "$(jq '(.testFailures // []) | length' <<<"$json")" != 0 ]] || return 0
    {
      echo "Failing tests ($bundle):"
      jq -r '(.testFailures // [])[] |
        "  - \(.testIdentifierString // .testName // "?")\n      \(.failureText // "(no message)")"' <<<"$json"
      jq -r '"Totals: \(.passedTests // 0) passed, \(.failedTests // 0) failed, \(.skippedTests // 0) skipped"' <<<"$json"
    } | cap >&2
  else
    echo "$json" | cap >&2
  fi
}

run_tests() { # run_tests <name> <target> [filter]
  local name="$1" target="$2" filter="${3:-}"
  local only="$target" bundle="$RESULTS/$name-$$.xcresult" rc=0
  [[ -n "$filter" ]] && only="$target/$filter"
  mkdir -p "$RESULTS"
  find "$RESULTS" -maxdepth 1 -name '*.xcresult' -mmin +240 -exec rm -rf {} + 2>/dev/null || true
  # No parallel testing: it boots a fresh "Clone N of iPhone Duo" per run, and a fresh clone crashed PosterBoard.
  run_logged "$name" xcb test -parallel-testing-enabled NO -only-testing:"$only" -resultBundlePath "$bundle" || rc=$?
  # Xcode infrastructure flake (no test ran): retry once, never for a real test failure.
  if ((rc != 0)) && xcrun xcresulttool get test-results summary --path "$bundle" --compact 2>/dev/null |
    grep -q 'hung before establishing connection'; then
    # A retry against the same simulator hung again (2026-11-03); a cold boot cleared it.
    echo "dev: test runner hung before connecting; rebooting the simulator and retrying once" >&2
    xcrun simctl shutdown "$DEV_SIM" >/dev/null 2>&1 || true
    rm -rf "$bundle"; rc=0
    run_logged "$name" xcb test -parallel-testing-enabled NO -only-testing:"$only" -resultBundlePath "$bundle" || rc=$?
  fi
  if ((rc != 0)); then
    report_failures "$bundle"
    return "$rc"
  fi
  test_summary "$name" "$only" "$bundle" && rm -rf "$bundle"
}

# One-line totals from an xcresult bundle; fails when no test ran (a filter that matched nothing exits 0).
test_summary() { # test_summary <name> <only> <bundle>
  local name="$1" only="$2" bundle="$3" json total
  json=$(xcrun xcresulttool get test-results summary --path "$bundle" --compact 2>/dev/null) || json="{}"
  total=$(jq '.totalTestCount // 0' <<<"$json" 2>/dev/null) || total=0
  if ((total == 0)); then
    echo "FAILED: $name — no tests matched '$only'" >&2
    return 1
  fi
  jq -r --arg n "$name" '"\($n): \(.passedTests // 0) passed, \(.failedTests // 0) failed, \(.skippedTests // 0) skipped"' <<<"$json"
}

cmd_build() { run_logged build xcb build; }
cmd_test() { run_tests test WorkoutsTests "${1:-}"; }
cmd_ui_test() { run_tests ui-test WorkoutsUITests "${1:-}"; }

cmd_kit() {
  [[ -d "$KIT" ]] || die "$KIT does not exist"
  if [[ -n "${1:-}" ]]; then
    run_logged kit bash -c 'cd "$1" && swift test --filter "$2"' _ "$KIT" "$1"
  else
    run_logged kit bash -c 'cd "$1" && swift test' _ "$KIT"
  fi
  kit_summary "${1:-}"
}

# swift test exits 0 when --filter matches nothing; turn that into a failure, else print the totals line.
kit_summary() { # kit_summary <filter>
  local log="$LAST_LOG" line
  if grep -q 'No matching test cases were run' "$log"; then
    echo "FAILED: kit — no tests matched filter '$1' (check the suite/test name)" >&2
    return 1
  fi
  line=$(grep -E 'Test run with .* passed' "$log" | tail -n 1 || true)
  if [[ -n "$line" ]]; then
    echo "kit: Test run with ${line#*Test run with }"
  else
    echo "kit: ok"
  fi
}
cmd_kit_build() {
  [[ -d "$KIT" ]] || die "$KIT does not exist"
  run_logged kit-build bash -c 'cd "$1" && swift build' _ "$KIT"
}

swift_format() { # swift_format <lint --strict|format --in-place>
  xcrun swift-format "$@" --recursive --parallel "${LINT_PATHS[@]}"
}
cmd_lint() {
  local out rc=0
  out=$(swift_format lint --strict 2>&1) || rc=$?
  if ((rc != 0)); then
    echo "$out" | cap >&2
    echo "FAILED: lint (exit $rc). Fix with: ./dev format" >&2
  fi
  return "$rc"
}
cmd_format() { swift_format format --in-place; }

find_app() {
  local app
  app=$(find "$DERIVED/Build/Products/Debug-iphonesimulator" -maxdepth 1 -name '*.app' -print -quit 2>/dev/null)
  [[ -n "$app" ]] || die "no .app found under $DERIVED/Build/Products/Debug-iphonesimulator"
  echo "$app"
}

cmd_run() { # cmd_run [-- app launch args...]; args reach the app, e.g. ./dev run -- -preview Swatches
  [[ "${1:-}" == "--" ]] && shift
  local out
  if ! out=$(xcrun simctl boot "$DEV_SIM" 2>&1); then
    [[ "$out" == *"current state: Booted"* || "$out" == *"already"* ]] || die "boot failed: $out"
  fi
  open -a Simulator 2>/dev/null || true # absent on headless hosts; the sim still boots
  xcrun simctl bootstatus "$DEV_SIM" -b >/dev/null 2>&1 || true
  cmd_build
  xcrun simctl install booted "$(find_app)"
  xcrun simctl launch --terminate-running-process booted "$BUNDLE_ID" "$@"
  echo "logs: xcrun simctl spawn booted log stream --predicate 'subsystem == \"$BUNDLE_ID\"'"
}

cmd_screenshot() {
  local path="${1:-.build/screenshots/$(date +%Y%m%d-%H%M%S).png}"
  mkdir -p "$(dirname "$path")"
  # Multi-display devices (iPhone Duo) need --display; DEV_DISPLAY overrides the "primary" fallback.
  local out
  if ! out=$(xcrun simctl io booted screenshot "$path" 2>&1); then
    if [[ "$out" == *"--display"* ]]; then
      out=$(xcrun simctl io booted screenshot --display="${DEV_DISPLAY:-primary}" "$path" 2>&1) || die "screenshot failed: $out"
    else
      die "screenshot failed: $out"
    fi
  fi
  echo "$path"
}

# Simulator commands hold one machine-wide lock, so parallel agents (worktrees included) take turns on the simulator
# instead of racing it, and fail when any simulator process crashed while they ran. Seen 2026-11-03: a SpringBoard
# crash loop after `simctl io screenConfig --display=N power off` (now forbidden) and a PosterBoard crash while
# xcodebuild booted a parallel-testing clone. Each crash raises a "quit unexpectedly" dialog on Eric's Mac.
CRASH_DIR="$HOME/Library/Logs/DiagnosticReports"
SIM_LOCK="$HOME/Library/Caches/workouts-dev-sim.lock"
sim_lock() {
  local waited=0 owner
  until mkdir "$SIM_LOCK" 2>/dev/null; do
    owner=$(cat "$SIM_LOCK/pid" 2>/dev/null || true)
    if [[ -n "$owner" ]] && ! kill -0 "$owner" 2>/dev/null; then rm -rf "$SIM_LOCK"; continue; fi
    ((waited % 30 == 0)) && echo "dev: waiting for the simulator (held by pid ${owner:-?})" >&2
    sleep 2; waited=$((waited + 2))
    ((waited < 1800)) || die "simulator lock held for 30 min by pid ${owner:-?}; remove $SIM_LOCK if it is stale"
  done
  echo $$ >"$SIM_LOCK/pid"
  trap 'rm -rf "$SIM_LOCK"' EXIT
}
sim_crashes() { # sim_crashes <since-epoch>: simulator-process crash reports captured after <since-epoch>
  # Reads each report's own captureTime (files are sometimes re-touched long after the crash) and skips daemons killed
  # while a simulator shuts down (SIGTERM timeout), which are shutdown noise, not crashes.
  /usr/bin/python3 -I - "$CRASH_DIR" "$1" <<'PY'
import datetime, json, os, sys
root, since = sys.argv[1], float(sys.argv[2])
for name in sorted(os.listdir(root)):
    path = os.path.join(root, name)
    if not name.endswith(".ips") or os.path.getmtime(path) < since:
        continue
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
        body = json.loads(text[text.index("\n") + 1:])
        captured = datetime.datetime.strptime(body["captureTime"][:19], "%Y-%m-%d %H:%M:%S").timestamp()
    except Exception:
        continue
    if captured < since - 1 or "CoreSimulator.SimDevice" not in body.get("coalitionName", ""):
        continue
    if "SIGTERM_TIMEOUT" in json.dumps(body.get("termination", {})):
        continue
    proc = body.get("procName", name.split("-")[0])
    # Fatal: our own processes (a real bug) and the processes whose crash loops flood the Mac with dialogs.
    fatal = proc in {"Workouts", "WorkoutsLiveActivity", "SpringBoard", "PosterBoard", "backboardd"}
    print(("fatal " if fatal else "warn ") + name)
PY
}
sim_guarded() { # sim_guarded <cmd> [args...]
  local rc=0 crashes
  sim_lock
  local since; since=$(date +%s)
  # Not `"$@" || rc=$?`: bash disables `set -e` inside anything run in a `||` context, so check kept going past a
  # failed step and printed "check: ok" (2026-11-03). A subshell with errexit re-enabled stops at the first failure.
  set +e
  (set -e; "$@")
  rc=$?
  set -e
  crashes=$(sim_crashes "$since")
  # Other simulator daemons (assetsd, intelligencetasksd, ...) crash on their own now and then: report, do not fail.
  grep '^warn ' <<<"$crashes" | sed 's/^warn /dev: warning: simulator daemon crashed (not ours): /' >&2 || true
  crashes=$(grep '^fatal ' <<<"$crashes" | sed 's/^fatal //' || true)
  if [[ -n "$crashes" ]]; then
    echo "dev: a simulator process crashed during this command:" >&2
    echo "$crashes" | sed 's/^/dev:   /' >&2
    echo "dev: stop, run 'xcrun simctl shutdown all', and report it; do not keep testing. Reports: $CRASH_DIR" >&2
    exit 1
  fi
  return "$rc"
}

# Fold / rotate the iPhone Duo simulator through agent-device (callstack, MIT), pinned. It dispatches the simulator's
# own HID hinge event from a helper inside the simulator and reads the hinge angle back; verified 2026-11-03 with zero
# SpringBoard crashes, unlike `simctl io screenConfig` display toggling (forbidden). Each call opens an agent-device
# session on the running app, acts, captures the lit panel when a path is given, and closes the session.
AGENT_DEVICE=(npx --yes agent-device@0.21.36)
booted_udid() {
  xcrun simctl list devices booted | sed -n "s/.*$DEV_SIM (\([0-9A-F-]*\)) (Booted).*/\1/p" | head -1
}
agent_device_do() { # agent_device_do <fold|orientation> <value> [screenshot.png]
  local udid shot="${3:-}"
  udid=$(booted_udid); [[ -n "$udid" ]] || die "$DEV_SIM is not booted; ./dev run first"
  "${AGENT_DEVICE[@]}" open "$BUNDLE_ID" --udid "$udid" --timeout 120000 >/dev/null || die "agent-device open failed"
  local rc=0
  "${AGENT_DEVICE[@]}" "$1" "$2" --udid "$udid" || rc=$?
  if [[ $rc == 0 && -n "$shot" ]]; then
    mkdir -p "$(dirname "$shot")"; "${AGENT_DEVICE[@]}" screenshot "$shot" --udid "$udid" || rc=$?
  fi
  "${AGENT_DEVICE[@]}" close --udid "$udid" >/dev/null 2>&1 || true
  return "$rc"
}
cmd_home() { # background the app (Home screen) so the Live Activity / notifications show; the session is always closed
  local udid; udid=$(booted_udid); [[ -n "$udid" ]] || die "$DEV_SIM is not booted; ./dev run first"
  local rc=0
  "${AGENT_DEVICE[@]}" open com.apple.springboard --platform ios --udid "$udid" >/dev/null || rc=$?
  "${AGENT_DEVICE[@]}" close --udid "$udid" >/dev/null 2>&1 || true
  return "$rc"
}
cmd_fold() { [[ "${1:-}" =~ ^(closed|half-open|open)$ ]] || die "usage: fold closed|half-open|open [screenshot.png]"; agent_device_do fold "$1" "${2:-}"; }
cmd_orient() { [[ "${1:-}" =~ ^(portrait|portrait-upside-down|landscape-left|landscape-right)$ ]] || die "usage: orient portrait|landscape-left|landscape-right|portrait-upside-down [screenshot.png]"; agent_device_do orientation "$1" "${2:-}"; }

cmd_clean() { rm -rf .build; }

cmd_check() {
  cmd_lint || return
  cmd_kit || return
  cmd_build || return
  cmd_test || return
  # The PreToolUse hook that gates `git commit` compares this stamp's mtime against changed files.
  mkdir -p .build && touch .build/check.stamp
  echo "check: ok"
}

cmd_help() {
  cat <<'USAGE'
build              build the app for $DEV_SIM (default "iPhone Duo")
test [filter]      run WorkoutsTests (filter = suite or suite/test); prints totals, fails if none ran
ui-test [filter]   run WorkoutsUITests; prints totals, fails if none ran
kit [filter]       swift test in Packages/WorkoutsKit; prints summary line, fails if filter matched nothing
kit-build          swift build in Packages/WorkoutsKit
lint               swift-format lint --strict
format             swift-format in place
run [-- args]      boot sim, build, install, launch; args go to the app (-- -preview <Name>); prints log command
screenshot [path]  simulator screenshot (default .build/screenshots/<timestamp>.png)
home               send the app to the background (Home screen); agent-device session closed after
fold <pose> [png]  Duo hinge: closed|half-open|open (agent-device); png = capture of the lit panel
orient <o> [png]   portrait|landscape-left|landscape-right|portrait-upside-down; png as for fold
clean              rm -rf .build
check              lint, kit, build, test; stops at first failure; on success touches .build/check.stamp
help               this list
USAGE
}

sub="${1:-help}"
[[ $# -gt 0 ]] && shift
case "$sub" in
  build) cmd_build ;;
  test) sim_guarded cmd_test "$@" ;;
  ui-test) sim_guarded cmd_ui_test "$@" ;;
  kit) cmd_kit "$@" ;;
  kit-build) cmd_kit_build ;;
  lint) cmd_lint ;;
  format) cmd_format ;;
  run) sim_guarded cmd_run "$@" ;;
  screenshot) sim_guarded cmd_screenshot "$@" ;;
  home) sim_guarded cmd_home ;;
  fold) sim_guarded cmd_fold "$@" ;;
  orient) sim_guarded cmd_orient "$@" ;;
  clean) cmd_clean ;;
  check) sim_guarded cmd_check ;;
  help | -h | --help) cmd_help ;;
  *) cmd_help >&2; die "unknown command: $sub" ;;
esac
