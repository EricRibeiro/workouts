#!/usr/bin/env bash
# Single entry point for building, testing, and running Workouts. Quiet on success, focused on failure.
set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

SCHEME="Workouts"
BUNDLE_ID="com.ericribeiro.Workouts"
DERIVED=".build/DerivedData"
RESULTS=".build/results"
LOGS=".build/logs"
UI_STAMP=".build/ui-test.stamp"
UI_PROGRESS=".build/ui-test.progress"   # one line per shard while ./dev ui-test runs, then a final "done:" line (./dev ui-status)
UI_PROGRESS_DIR=".build/ui-test.progress.d" # per-shard state behind it, plus pid (the writer, for ui-status) and failed (append-only)
KIT="Packages/WorkoutsKit"
LINT_PATHS=(Workouts WorkoutsLiveActivity Shared WorkoutsTests WorkoutsUITests Packages Tools/duo)
DUO_SPM=".build/duo/spm"
DUO_BIN="$DUO_SPM/release/duo"
NOISE='IDERunDestination|IDESchemeActionDeviceRecord|IDETestOperationsObserverDebug'
MAX_LINES=80

die() { echo "dev: $*" >&2; exit 1; }

# Simulator pool. The original "iPhone Duo" plus clones "iPhone Duo 2".."iPhone Duo $DEV_SIM_POOL" (made by `./dev sims`),
# so parallel agents each get their own simulator instead of queueing on one. Every simulator has its own lock; a checkout
# remembers its simulator in .build/dev-sim-udid, so run -> screenshot -> fold hit one device and its fold pose sticks.
# DEV_SIM (name) or DEV_SIM_UDID override the assignment. Every simctl/xcodebuild call targets $SIM_UDID, never `booted`.
SIM_ORIGINAL="iPhone Duo"
SIM_POOL="${DEV_SIM_POOL:-5}"
CACHE_DIR="$HOME/Library/Caches"
SIM_CLAIM=".build/dev-sim-udid"
SIM_CLAIM_MAX_AGE_MIN=1440 # another checkout's claim counts for a day after it last used the simulator
SIM_IDLE_MIN="${DEV_SIM_IDLE_MIN:-30}"       # a booted pool simulator nobody has used for this long is shut down (0 = never)
SIM_POSTER_MAX="${DEV_SIM_POSTER_MAX:-1000}" # `./dev sims` erases a clone with more PosterKit temp entries than this
SIM_TABLE=""               # tab-separated name, udid, state of every available simulator
SIM_UDID=""
SIM_NAME=""
COLD_BOOT=0

sim_table_load() { SIM_TABLE=$(xcrun simctl list devices available -j | jq -r '.devices[][] | [.name, .udid, .state] | @tsv'); }
# The lookups read SIM_TABLE, so load it in the main shell first (sim_resolve and cmd_sims do).
sim_udid_by_name() { awk -F'\t' -v n="$1" '$1 == n { print $2; exit }' <<<"$SIM_TABLE"; }
sim_name_by_udid() { awk -F'\t' -v u="$1" '$2 == u { print $1; exit }' <<<"$SIM_TABLE"; }
sim_state_by_udid() { awk -F'\t' -v u="$1" '$2 == u { print $3; exit }' <<<"$SIM_TABLE"; }
sim_pool_names() {
  local i
  for ((i = 1; i <= SIM_POOL; i++)); do
    if ((i == 1)); then echo "$SIM_ORIGINAL"; else echo "$SIM_ORIGINAL $i"; fi
  done
}

# The original keeps the pre-pool lock path, so an older `dev` in another checkout still excludes correctly.
sim_lock_path() { # sim_lock_path <udid>
  if [[ -n "$1" && "$1" == "$(sim_udid_by_name "$SIM_ORIGINAL")" ]]; then
    echo "$CACHE_DIR/workouts-dev-sim.lock"
  else
    echo "$CACHE_DIR/workouts-dev-sim.$1.lock"
  fi
}
sim_lock_holder() { # live holder pid of a simulator's lock, else "-"
  local owner; owner=$(cat "$(sim_lock_path "$1")/pid" 2>/dev/null || true)
  if [[ -n "$owner" ]] && kill -0 "$owner" 2>/dev/null; then echo "$owner"; else echo "-"; fi
}
sim_lock_free() { # free = no lock directory, or its owner is dead
  [[ ! -d "$(sim_lock_path "$1")" ]] && return 0
  [[ "$(sim_lock_holder "$1")" == "-" ]] && [[ -n "$(cat "$(sim_lock_path "$1")/pid" 2>/dev/null || true)" ]]
}

# Best effort: does another checkout's .build/dev-sim-udid name this simulator? Looks at the main checkout and every
# .claude/worktrees/* checkout, and ignores claims not refreshed within SIM_CLAIM_MAX_AGE_MIN so finished worktrees free up.
sim_claim_files() { # every existing claim file: the main checkout's and each worktree's
  local common main f
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  main=$(dirname "$common")
  for f in "$main/$SIM_CLAIM" "$main"/.claude/worktrees/*/"$SIM_CLAIM"; do
    [[ -f "$f" ]] && echo "$f"
  done
}
sim_claimed() { # sim_claimed <udid>
  local f
  while IFS= read -r f; do
    [[ "$f" -ef "$SIM_CLAIM" ]] && continue
    [[ -n "$(find "$f" -mmin "-$SIM_CLAIM_MAX_AGE_MIN" 2>/dev/null)" ]] || continue
    [[ "$(cat "$f" 2>/dev/null || true)" == "$1" ]] && return 0
  done < <(sim_claim_files)
  return 1
}

sim_pick() { # first pool member that is lock-free and unclaimed; else a lock-free one; else the original
  local name udid
  while IFS= read -r name; do
    udid=$(sim_udid_by_name "$name"); [[ -n "$udid" ]] || continue
    if sim_lock_free "$udid" && ! sim_claimed "$udid"; then echo "$udid"; return; fi
  done < <(sim_pool_names)
  while IFS= read -r name; do
    udid=$(sim_udid_by_name "$name"); [[ -n "$udid" ]] || continue
    if sim_lock_free "$udid"; then echo "$udid"; return; fi
  done < <(sim_pool_names)
  sim_udid_by_name "$SIM_ORIGINAL"
}

# Sets SIM_UDID and SIM_NAME once per process and says which simulator on one stderr line. Call it in the main shell
# (not inside $(...) or a pipeline) before anything that needs the simulator.
sim_resolve() {
  [[ -z "$SIM_UDID" ]] || return 0
  sim_table_load
  local remembered mutex="$CACHE_DIR/workouts-dev-sim-pick.lock" n=0
  if [[ -n "${DEV_SIM_UDID:-}" ]]; then
    SIM_UDID="$DEV_SIM_UDID"
    SIM_NAME=$(sim_name_by_udid "$SIM_UDID"); [[ -n "$SIM_NAME" ]] || die "DEV_SIM_UDID $SIM_UDID is not an available simulator"
  elif [[ -n "${DEV_SIM:-}" ]]; then
    SIM_NAME="$DEV_SIM"
    SIM_UDID=$(sim_udid_by_name "$SIM_NAME"); [[ -n "$SIM_UDID" ]] || die "no available simulator named '$SIM_NAME'"
  else
    remembered=$(cat "$SIM_CLAIM" 2>/dev/null || true)
    if [[ -n "$remembered" && -n "$(sim_name_by_udid "$remembered")" ]]; then
      SIM_UDID="$remembered"
    else
      # Two checkouts picking at once must not both take the same free simulator: serialize the pick (it takes ~1s).
      until mkdir "$mutex" 2>/dev/null; do
        [[ -z "$(find "$mutex" -maxdepth 0 -mmin +1 2>/dev/null)" ]] || rm -rf "$mutex"
        sleep 0.2; n=$((n + 1)); ((n < 100)) || break
      done
      SIM_UDID=$(sim_pick)
      [[ -n "$SIM_UDID" ]] || { rm -rf "$mutex"; die "no '$SIM_ORIGINAL' simulator found"; }
      mkdir -p "$(dirname "$SIM_CLAIM")"; echo "$SIM_UDID" >"$SIM_CLAIM"
      rm -rf "$mutex"
    fi
    SIM_NAME=$(sim_name_by_udid "$SIM_UDID")
    touch "$SIM_CLAIM" 2>/dev/null || { mkdir -p "$(dirname "$SIM_CLAIM")"; echo "$SIM_UDID" >"$SIM_CLAIM"; }
  fi
  echo "dev: simulator $SIM_NAME ($SIM_UDID)" >&2
  sim_reap_idle
}

# Print at most MAX_LINES of stdin, noting truncation.
cap() {
  awk -v max="$MAX_LINES" 'NR <= max { print } NR == max + 1 { print "... (truncated)" }'
}

# Run a command, logging combined output to $LOGS/$1.log (noise filtered, or xcbeautify if present).
# Prints nothing on success; on failure prints an error excerpt and returns the command's exit code.
# Logs and result bundles carry the PID so parallel workers running the same command do not clobber each other.
run_logged() {
  local name="$1"; shift
  local log="$LOGS/$name-$$.log" rc errexit=0
  mkdir -p "$LOGS"
  find "$LOGS" -name '*.log' -mmin +240 -delete 2>/dev/null || true
  LAST_LOG="$log"
  # Give errexit back the way we found it. An unconditional `set -e` here switched it on for a caller that had turned it
  # off on purpose (cmd_ui_test around ui_test_sharded), so that function's `return 3` killed the script with status 3
  # instead of reaching the single-simulator fallback.
  [[ $- != *e* ]] || errexit=1
  set +e
  # RUN_LOGGED_TAP (a function name) sits between the command and the filter: it reads the raw stream, may record progress,
  # and passes on what the log should keep. Unset (everything but the ui-test runs), the pipeline is what it always was.
  local tap=cat
  [[ -z "${RUN_LOGGED_TAP:-}" ]] || tap="$RUN_LOGGED_TAP"
  if command -v xcbeautify >/dev/null 2>&1; then
    "$@" 2>&1 | "$tap" | xcbeautify --quiet >"$log"
  else
    "$@" 2>&1 | "$tap" | { grep -Ev "$NOISE" || true; } >"$log"
  fi
  rc=${PIPESTATUS[0]}
  if ((errexit)); then set -e; fi
  if ((rc != 0)); then
    echo "FAILED: $name (exit $rc), full log: $log" >&2
    excerpt "$log" | cap >&2
  fi
  return "$rc"
}

# Pull the interesting lines from a log: errors first, otherwise the tail.
excerpt() {
  local log="$1"
  if grep -qE '(error:|error\b.*:|\*\* .* FAILED|✖|❌|Test .* failed|Issue recorded)' "$log"; then
    grep -E '(error:|\*\* .* FAILED|✖|❌|Test .* failed|Issue recorded)' "$log" | awk '!seen[$0]++'
  else
    tail -n 40 "$log"
  fi
}

xcb() { # xcb <action> [extra xcodebuild args...]; XCB_VERBOSE (set by run_tests for ui-test) drops -quiet so per-test lines reach the tap
  local action="$1"; shift
  local quiet=(-quiet)
  [[ -z "${XCB_VERBOSE:-}" ]] || quiet=()
  xcodebuild "$action" -scheme "$SCHEME" -destination "platform=iOS Simulator,id=$SIM_UDID" \
    -derivedDataPath "$DERIVED" ${quiet[@]+"${quiet[@]}"} "$@"
}

# Reduce an xcresult bundle to its failing tests.
report_failures() {
  local bundle="$1"
  [[ -d "$bundle" ]] || return 0
  local json
  json=$(xcrun xcresulttool get test-results summary --path "$bundle" --compact 2>/dev/null) || return 0
  if command -v jq >/dev/null 2>&1; then
    # No failures listed means the build died before any test ran; the log excerpt already said why.
    [[ "$(jq '(.testFailures // []) | length' <<<"$json")" != 0 ]] || return 0
    {
      echo "Failing tests ($bundle):"
      jq -r '(.testFailures // [])[] |
        "  - \(.testIdentifierString // .testName // "?")\n      \(.failureText // "(no message)")"' <<<"$json"
      jq -r '"Totals: \(.passedTests // 0) passed, \(.failedTests // 0) failed, \(.skippedTests // 0) skipped"' <<<"$json"
    } | cap >&2
  else
    echo "$json" | cap >&2
  fi
}

# A pool simulator keeps whatever text size and appearance an earlier session left it at (an accessibility size once
# failed UI tests that pass at Large). Reset both before a test run; `simctl ui` needs a booted device, so boot it headless
# first. Not display toggles: these are the same settings as Settings > Display & Brightness / Display Size.
sim_reset_ui() { # sim_reset_ui <udid>
  xcrun simctl boot "$1" >/dev/null 2>&1 || true
  xcrun simctl bootstatus "$1" -b >/dev/null 2>&1 || true
  xcrun simctl ui "$1" content_size large >/dev/null 2>&1 || true
  xcrun simctl ui "$1" appearance light >/dev/null 2>&1 || true
}

run_tests() { # run_tests <name> <target> [filter]
  local name="$1" target="$2" filter="${3:-}"
  local only="$target" bundle="$RESULTS/$name-$$.xcresult" rc=0
  # ui-test: the single-simulator run reports progress too (shard 1/1); see ui_progress_tap.
  local XCB_VERBOSE="" RUN_LOGGED_TAP="" UI_PROG_IDX=1 UI_PROG_OF=1 UI_PROG_SIM="" UI_PROG_TOTAL=""
  sim_resolve
  if [[ "$name" == ui-test ]]; then
    XCB_VERBOSE=1 RUN_LOGGED_TAP=ui_progress_tap UI_PROG_SIM=$(sim_name_by_udid "$SIM_UDID")
  fi
  sim_reset_ui "$SIM_UDID"
  [[ -n "$filter" ]] && only="$target/$filter"
  mkdir -p "$RESULTS"
  find "$RESULTS" -maxdepth 1 -name '*.xcresult' ! -name 'latest-*' -mmin +240 -exec rm -rf {} + 2>/dev/null || true
  # No parallel testing: it boots a fresh "Clone N of iPhone Duo" per run, and a fresh clone crashed PosterBoard.
  run_logged "$name" xcb test -parallel-testing-enabled NO -enableCodeCoverage YES -collect-test-diagnostics on-failure -only-testing:"$only" -resultBundlePath "$bundle" || rc=$?
  # Xcode infrastructure flake (no test ran): retry once, never for a real test failure.
  if ((rc != 0)) && xcrun xcresulttool get test-results summary --path "$bundle" --compact 2>/dev/null |
    grep -q 'hung before establishing connection'; then
    # A retry against the same simulator hung again (2026-11-03); a cold boot cleared it.
    echo "dev: test runner hung before connecting; rebooting the simulator and retrying once" >&2
    xcrun simctl shutdown "$SIM_UDID" >/dev/null 2>&1 || true
    rm -rf "$bundle"; rc=0
    run_logged "$name" xcb test -parallel-testing-enabled NO -enableCodeCoverage YES -collect-test-diagnostics on-failure -only-testing:"$only" -resultBundlePath "$bundle" || rc=$?
  fi
  if ((rc != 0)); then
    report_failures "$bundle"
    return "$rc"
  fi
  # Keep only the newest successful bundle per kind, for `./dev coverage`; a bundle that ran nothing is dropped.
  if test_summary "$name" "$only" "$bundle"; then
    rm -rf "$RESULTS/latest-$name.xcresult"
    mv "$bundle" "$RESULTS/latest-$name.xcresult"
  else
    rm -rf "$bundle"
    return 1
  fi
}

# One-line totals from an xcresult bundle; fails when no test ran (a filter that matched nothing exits 0).
test_summary() { # test_summary <name> <only> <bundle>
  local name="$1" only="$2" bundle="$3" json total
  json=$(xcrun xcresulttool get test-results summary --path "$bundle" --compact 2>/dev/null) || json="{}"
  total=$(jq '.totalTestCount // 0' <<<"$json" 2>/dev/null) || total=0
  if ((total == 0)); then
    echo "FAILED: $name — no tests matched '$only'" >&2
    return 1
  fi
  local line
  line=$(jq -r --arg n "$name" '"\($n): \(.passedTests // 0) passed, \(.failedTests // 0) failed, \(.skippedTests // 0) skipped"' <<<"$json")
  echo "$line"
  [[ "$name" != ui-test ]] || ui_progress_done "$line"
}

cmd_build() { sim_resolve; run_logged build xcb build; }
cmd_test() {
  # Snapshot tests (WorkoutsTests/Snapshot) record their references when the runner sees SNAPSHOT_RECORD; xcodebuild only
  # forwards TEST_RUNNER_-prefixed variables, so map it here. Recording makes the run fail once by design.
  [[ -n "${SNAPSHOT_RECORD:-}" ]] && export TEST_RUNNER_SNAPSHOT_RECORD="$SNAPSHOT_RECORD"
  run_tests test WorkoutsTests "${1:-}"
}
cmd_ui_test() {
  # HealthKitIntegrationUITests (real Health store, drives the permission sheet) skips itself unless this is set; xcodebuild
  # forwards TEST_RUNNER_-prefixed variables to the test runner. Naming the suite in the filter opts in; the full suite and
  # `check` leave it skipped.
  [[ "${1:-}" == HealthKitIntegration* ]] && export TEST_RUNNER_HEALTH_INTEGRATION=1
  local rc=0
  ui_progress_begin
  if [[ -z "${1:-}" ]] && ((${DEV_UI_SHARDS:-3} > 1)); then
    # Not `ui_test_sharded || rc=$?`: that would disable errexit inside it (see sim_guarded).
    set +e; ui_test_sharded; rc=$?; set -e
    if ((rc == 3)); then rc=0; ui_progress_begin; run_tests ui-test WorkoutsUITests "" || rc=$?; fi # fewer than 2 free simulators: one, as before
    ((rc == 0)) || { ui_progress_done "FAILED (exit $rc)"; return "$rc"; }
  else
    run_tests ui-test WorkoutsUITests "${1:-}" || { rc=$?; ui_progress_done "FAILED (exit $rc)"; return "$rc"; }
  fi
  # The ship gate: only a full, passing run (no filter) vouches for a commit; `testflight --upload` checks this stamp.
  if [[ -z "${1:-}" ]]; then
    local clean=0
    [[ -z "$(git status --porcelain 2>/dev/null)" ]] && clean=1
    mkdir -p .build && printf 'commit=%s\nclean=%s\nflaky=%s\n' "$(git rev-parse HEAD)" "$clean" "${UI_FLAKY:-none}" >"$UI_STAMP"
  fi
}

# The full UI suite is sharded across the simulator pool (DEV_UI_SHARDS, default 3; 1 = the old single-simulator run):
# one build-for-testing, then each shard runs `test-without-building -only-testing:<suites>` on its own simulator, taken
# through the normal lock (sim_grab), so other agents and the idle reaper leave it alone. Shard 1 is this command's own
# simulator (sim_guarded holds its lock and the crash guard covers it and the borrowed ones). Suites are dealt out greedily,
# longest first, from the durations of the last passing run. Every suite runs, the opt-in ones (PerfDriverUITests,
# HealthKitIntegrationUITests) included: they skip themselves unless their env flag is set, exactly as in the single run.
UI_DURATIONS=".build/ui-test-durations.tsv" # <suite> TAB <seconds> from the last passing sharded run
UI_TOTAL=".build/ui-test-total"             # tests (skipped included) in the last passing sharded run
UI_FLAKY_LOG=".build/ui-flaky.log"          # <utc time> <commit> <test id> per test that failed, then passed on retry
UI_SHARDS_DIR="$RESULTS/ui-test-shards"
UI_SIMS=()
UI_PIDS=()
UI_N=1  # shards in this run (the "2/3" of the progress lines)
UI_T0=$SECONDS
UI_FLAKY="" # comma-separated ids of the tests that were flaky in this run, for the stamp
# Progress for ./dev ui-status: $UI_PROGRESS holds one line per shard, then every FAILED test in the order it happened, then a
# final "done:" line (kept after the run). It is composed from files in $UI_PROGRESS_DIR (shard-N.line, failed, done), because
# the shards update it from separate processes; pid there is the writer, so ui-status can tell a live run from a dead one.
ui_progress_render() {
  local tmp; tmp=$(mktemp "$UI_PROGRESS.XXXXXX") || return 0 # not BASHPID: macOS ships bash 3.2
  { cat "$UI_PROGRESS_DIR"/shard-*.line "$UI_PROGRESS_DIR/failed" "$UI_PROGRESS_DIR/done"; } 2>/dev/null >"$tmp" || true
  mv -f "$tmp" "$UI_PROGRESS" 2>/dev/null || true
}
ui_progress_set() { # ui_progress_set <shard> <text>
  local tmp; tmp=$(mktemp "$UI_PROGRESS_DIR/tmp.XXXXXX") || return 0
  printf '%s\n' "$2" >"$tmp" && mv -f "$tmp" "$UI_PROGRESS_DIR/shard-$1.line"
  ui_progress_render
}
ui_progress_begin() {
  UI_T0=$SECONDS
  rm -rf "$UI_PROGRESS_DIR" "$UI_PROGRESS"; mkdir -p "$UI_PROGRESS_DIR"
  echo $$ >"$UI_PROGRESS_DIR/pid"
  ui_progress_set 0 "starting (building)"
}
ui_progress_done() { # ui_progress_done <totals line>: the last line of the file
  [[ -d "$UI_PROGRESS_DIR" ]] || return 0
  printf 'done: %s\n' "$1" >"$UI_PROGRESS_DIR/done"
  ui_progress_render
}
ui_progress_fmt_elapsed() { local s=$((SECONDS - UI_T0)); if ((s >= 60)); then printf '%dm' $((s / 60)); else printf '%ds' "$s"; fi; }
# A pipeline stage for run_logged (RUN_LOGGED_TAP) around a ui-test xcodebuild: reads the raw, non-quiet stream, keeps this
# shard's line current (UI_PROG_IDX/OF/SIM/TOTAL) and appends each failure to the file the moment it prints. The per-test and
# per-step lines are consumed, so the log filter sees roughly what -quiet printed and the failure excerpt reads as before.
ui_progress_tap() {
  local line p=0 f=0 k=0 last="" id res of="${UI_PROG_TOTAL:+/$UI_PROG_TOTAL}" skipped
  rm -f "$UI_PROGRESS_DIR/shard-0.line" # the "starting (building)" placeholder, once a real shard line takes over
  ui_progress_set "$UI_PROG_IDX" "shard $UI_PROG_IDX/$UI_PROG_OF ($UI_PROG_SIM): 0${of} passed, 0 failed, starting"
  while IFS= read -r line || [[ -n "$line" ]]; do
    id=""
    if [[ "$line" =~ ^Test\ [Cc]ase\ \'-\[([A-Za-z0-9_]+\.)?([A-Za-z0-9_]+)\ ([A-Za-z0-9_]+)\]\'\ (passed|failed|skipped) ]]; then
      id="${BASH_REMATCH[2]}/${BASH_REMATCH[3]}"; res="${BASH_REMATCH[4]}"
    elif [[ "$line" =~ ^Test\ [Cc]ase\ \'([A-Za-z0-9_]+/[^\']+)\'\ (passed|failed|skipped) ]]; then
      id="${BASH_REMATCH[1]}"; res="${BASH_REMATCH[2]}"
    fi
    if [[ -n "$id" ]]; then
      case "$res" in
        passed) p=$((p + 1)) ;;
        failed) f=$((f + 1)); printf 'FAILED %s\n' "$id" >>"$UI_PROGRESS_DIR/failed" ;;
        skipped) k=$((k + 1)) ;;
      esac
      last="$id"; skipped=""
      ((k == 0)) || skipped=", $k skipped"
      ui_progress_set "$UI_PROG_IDX" "shard $UI_PROG_IDX/$UI_PROG_OF ($UI_PROG_SIM): $p${of} passed, $f failed$skipped, last=$last, $(ui_progress_fmt_elapsed)"
      continue
    fi
    [[ "$line" =~ ^(Test\ Suite|Test\ [Cc]ase|[[:space:]]+t\ =|[[:space:]]+Executed\ ) ]] || printf '%s\n' "$line"
  done
}
ui_suites() { # ui_suites <xctestrun>: the UI test classes the built bundle contains; the source grep is only a fallback
  local tmp suites; tmp=$(mktemp -d)
  if xcodebuild test-without-building -xctestrun "$1" -destination "platform=iOS Simulator,id=$SIM_UDID" -enumerate-tests \
    -test-enumeration-style flat -test-enumeration-format json -test-enumeration-output-path "$tmp/enum.json" \
    -resultBundlePath "$tmp/enum.xcresult" >/dev/null 2>&1; then
    suites=$(jq -r '.values[].enabledTests[]?.identifier | select(startswith("WorkoutsUITests/")) | split("/")[1]' "$tmp/enum.json" 2>/dev/null | sort -u || true)
    # tests per suite, for the progress file's N in "41/45 passed"
    jq -r '[.values[].enabledTests[]?.identifier | select(startswith("WorkoutsUITests/")) | split("/")[1]] | group_by(.)[] | "\(.[0])\t\(length)"' \
      "$tmp/enum.json" >"$UI_PROGRESS_DIR/counts.tsv" 2>/dev/null || rm -f "$UI_PROGRESS_DIR/counts.tsv"
  fi
  rm -rf "$tmp"
  if [[ -z "${suites:-}" ]]; then
    echo "dev: warning: could not enumerate the tests in the built bundle; falling back to grepping the sources" >&2
    suites=$(find WorkoutsUITests -name '*.swift' -exec sed -nE 's/^(final )?class ([A-Za-z0-9_]+): *XCTestCase.*/\2/p' {} + | sort -u)
  fi
  echo "$suites"
}
ui_fmt_secs() { if (($1 >= 60)); then printf '%dm%02ds' $(($1 / 60)) $(($1 % 60)); else printf '%ds' "$1"; fi; }
ui_load_high() { # prints "<load> <cpus>" and succeeds when the 1-minute load average is above four times the CPU count
  local load cpus; load=$(sysctl -n vm.loadavg | awk '{ print $2 }'); cpus=$(sysctl -n hw.ncpu)
  awk -v l="$load" -v c="$cpus" 'BEGIN { exit !(l > 4 * c) }' && echo "$load $cpus"
}
ui_balance() { # ui_balance <shards> <suite...>: "<shard> <suite>" lines; a suite without history counts as the mean of the known
  local n="$1" s; shift
  for s in "$@"; do
    printf '%s\t%s\n' "$(awk -F'\t' -v s="$s" '$1 == s { print $2; exit }' "$UI_DURATIONS" 2>/dev/null || true)" "$s"
  done | awk -F'\t' -v n="$n" '
    { name[NR] = $2; dur[NR] = $1; if ($1 != "") { sum += $1; known++ } }
    END {
      avg = known ? sum / known : 1
      for (i = 1; i <= NR; i++) { if (dur[i] == "") dur[i] = avg; if (dur[i] < 1) dur[i] = 1 }
      for (k = 1; k <= NR; k++) {
        b = 0; for (i = 1; i <= NR; i++) if (!used[i] && (b == 0 || dur[i] > dur[b])) b = i
        used[b] = 1; m = 1; for (j = 2; j <= n; j++) if (load[j] < load[m]) m = j
        load[m] += dur[b]; print m, name[b]
      }
    }'
}
ui_pick_sims() { # ui_pick_sims <want>: UI_SIMS = this command's simulator + up to want-1 free pool simulators, locked
  local want="$1" pass name udid
  UI_SIMS=("$SIM_UDID")
  for pass in unclaimed claimed; do # a simulator another checkout has claimed is borrowed only once it has sat idle
    while IFS= read -r name; do
      ((${#UI_SIMS[@]} < want)) || break
      udid=$(sim_udid_by_name "$name"); [[ -n "$udid" && " ${UI_SIMS[*]} " != *" $udid "* ]] || continue
      if [[ "$pass" == unclaimed ]]; then ! sim_claimed "$udid" || continue; else ! sim_hands_off "$udid" || continue; fi
      sim_grab "$udid" || continue
      UI_SIMS+=("$udid"); echo "$udid" >>"$SIM_HELD_FILE"
    done < <(sim_pool_names)
  done
}
ui_bundle_suites() { # ui_bundle_suites <xcresult>: "<suite> TAB <seconds>" for every suite with at least one test case
  xcrun xcresulttool get test-results tests --path "$1" --compact 2>/dev/null | jq -r '
    [.. | objects | select(.nodeType == "Test Case" and .nodeIdentifier != null)]
    | group_by(.nodeIdentifier | split("/")[0])[]
    | [(.[0].nodeIdentifier | split("/")[0]), ([.[].durationInSeconds // 0] | add | round)] | @tsv' 2>/dev/null || true
}
# Re-run a shard's failed tests once, on the same simulator. Succeeds only when exactly those tests ran again and all of
# them passed; a failure that cannot be named test by test, or a test that was already flaky in the previous full run, is
# never retried. The retried ids go to shard-N.retried and are reported as flaky.
ui_shard_retry() { # ui_shard_retry <index> <udid> <xctestrun> <bundle>
  local idx="$1" udid="$2" xr="$3" bundle="$4" ids=() id only=() json retry rrc=0 failed prev
  retry="$PWD/$UI_SHARDS_DIR/retry-$idx.xcresult"
  json=$(xcrun xcresulttool get test-results summary --path "$bundle" --compact 2>/dev/null) || return 1
  while read -r id; do [[ -z "$id" ]] || ids+=("$id"); done < <(jq -r '(.testFailures // [])[].testIdentifierString' <<<"$json" 2>/dev/null | sort -u)
  failed=$(jq '.failedTests // 0' <<<"$json" 2>/dev/null) || return 1
  ((${#ids[@]} > 0 && failed == ${#ids[@]})) || return 1
  prev=$(sed -n 's/^flaky=//p' "$UI_STAMP" 2>/dev/null || true)
  for id in "${ids[@]}"; do
    case ",$prev," in *",$id,"*) echo "dev: $id was flaky in the previous full run too; not retrying it" >&2; return 1 ;; esac
    only+=(-only-testing:"WorkoutsUITests/$id")
  done
  rm -rf "$retry"
  run_logged "ui-test-shard$idx-retry" xcodebuild test-without-building -xctestrun "$xr" \
    -destination "platform=iOS Simulator,id=$udid" -parallel-testing-enabled NO -enableCodeCoverage YES -collect-test-diagnostics on-failure "${only[@]}" \
    -resultBundlePath "$retry" -quiet >/dev/null 2>&1 || rrc=$?
  json=$(xcrun xcresulttool get test-results summary --path "$retry" --compact 2>/dev/null) || return 1
  ((rrc == 0)) || return 1
  [[ "$(jq '.totalTestCount // 0' <<<"$json")" == "${#ids[@]}" && "$(jq '.passedTests // 0' <<<"$json")" == "${#ids[@]}" &&
    "$(jq '.failedTests // 0' <<<"$json")" == 0 ]] || return 1
  printf '%s\n' "${ids[@]}" >"$UI_SHARDS_DIR/shard-$idx.retried"
}
ui_shard() { # ui_shard <index> <udid> <xctestrun> <suite...>; runs in a background subshell
  local idx="$1" udid="$2" xr="$3" bundle only=() s attempt rc=0 t0=$SECONDS
  shift 3
  bundle="$PWD/$UI_SHARDS_DIR/shard-$idx.xcresult" # absolute: ui_cleanup finds this checkout's xcodebuilds by it
  sim_reset_ui "$udid"
  for s in "$@"; do only+=(-only-testing:"WorkoutsUITests/$s"); done
  # Progress: no -quiet here, so xcodebuild prints each test's result and ui_progress_tap (between it and the log filter)
  # turns them into this shard's line in the progress file. The planned test count comes from the enumeration, if it worked.
  local RUN_LOGGED_TAP=ui_progress_tap UI_PROG_IDX="$idx" UI_PROG_OF="$UI_N" UI_PROG_SIM UI_PROG_TOTAL=""
  UI_PROG_SIM=$(sim_name_by_udid "$udid")
  if [[ -s "$UI_PROGRESS_DIR/counts.tsv" ]]; then
    UI_PROG_TOTAL=$(printf '%s\n' "$@" | awk -F'\t' 'NR == FNR { want[$1] = 1; next } $1 in want { n += $2 } END { if (n) print n }' - "$UI_PROGRESS_DIR/counts.tsv")
  fi
  for attempt in 1 2; do
    rm -rf "$bundle"; rc=0
    run_logged "ui-test-shard$idx" xcodebuild test-without-building -xctestrun "$xr" \
      -destination "platform=iOS Simulator,id=$udid" -parallel-testing-enabled NO -enableCodeCoverage YES -collect-test-diagnostics on-failure \
      "${only[@]}" -resultBundlePath "$bundle" >/dev/null 2>&1 || rc=$?
    # Xcode infrastructure flake (no test ran): retry once on a cold boot, as run_tests does.
    ((rc != 0 && attempt == 1)) || break
    xcrun xcresulttool get test-results summary --path "$bundle" --compact 2>/dev/null | grep -q 'hung before establishing connection' || break
    xcrun simctl shutdown "$udid" >/dev/null 2>&1 || true
  done
  # Four simulators at once load the machine enough to time out a test that passes alone: one visible retry (DEV_UI_RETRY=0 off).
  if ((rc != 0 && ${DEV_UI_RETRY:-1} > 0)); then ui_shard_retry "$idx" "$udid" "$xr" "$bundle" && rc=0; fi
  echo $((SECONDS - t0)) >"$UI_SHARDS_DIR/shard-$idx.secs"
  return "$rc"
}
ui_record_durations() { # per-suite seconds of this passing run into UI_DURATIONS (suites not in the run keep their old value)
  local tmp b; tmp=$(mktemp)
  for b in "$UI_SHARDS_DIR"/shard-*.xcresult; do ui_bundle_suites "$b" >>"$tmp"; done
  if [[ -f "$UI_DURATIONS" ]]; then awk -F'\t' 'NR == FNR { seen[$1] = 1; next } !($1 in seen)' "$tmp" "$UI_DURATIONS" >>"$tmp"; fi
  mkdir -p .build; sort "$tmp" >"$UI_DURATIONS"; rm -f "$tmp"
}
# Interrupt or exit: stop this checkout's shard xcodebuilds (matched by their absolute result path) and give the borrowed
# simulators back. Idempotent.
ui_cleanup() {
  local udid
  ((${#UI_PIDS[@]} == 0)) || kill "${UI_PIDS[@]}" 2>/dev/null || true
  pkill -f "xcodebuild test-without-building.*$PWD/$UI_SHARDS_DIR/" 2>/dev/null || true
  UI_PIDS=()
  if ((${#UI_SIMS[@]} > 1)); then
    for udid in "${UI_SIMS[@]:1}"; do sim_drop "$udid"; done
    UI_SIMS=("${UI_SIMS[0]}")
  fi
}
# Returns 0 when every shard passed, 1 on any failure, 3 when only one shard is possible (the caller runs the single path).
ui_test_sharded() {
  local want="${DEV_UI_SHARDS:-3}" suites=() s xr n i plan udid t0=$SECONDS load
  if [[ -z "${DEV_UI_IGNORE_LOAD:-}" ]] && load=$(ui_load_high); then
    echo "dev: ui-test: load average ${load% *} is above 2 x ${load#* } CPUs; running 1 shard" >&2
    return 3
  fi
  mkdir -p "$RESULTS"
  ui_progress_set 0 "building (build-for-testing), then $want shards"
  run_logged ui-test-build xcb build-for-testing -enableCodeCoverage YES || return 1
  xr=$(find "$DERIVED/Build/Products" -name '*.xctestrun' -exec stat -f '%m %N' {} + | sort -rn | head -1 | cut -d' ' -f2-)
  [[ -n "$xr" ]] || die "ui-test: build-for-testing produced no .xctestrun under $DERIVED/Build/Products"
  while IFS= read -r s; do [[ -z "$s" ]] || suites+=("$s"); done < <(ui_suites "$xr")
  ((${#suites[@]} > 0)) || die "ui-test: found no UI test classes"
  if ((want > ${#suites[@]})); then want=${#suites[@]}; fi
  ui_pick_sims "$want"
  n=${#UI_SIMS[@]}
  if ((n < want)); then echo "dev: ui-test: only $n of the $want wanted shards: no more free pool simulators" >&2; fi
  # errexit must be off when this returns 3, or the caller's shell exits before it can read the status (belt and braces:
  # run_logged above used to switch it back on).
  ((n >= 2)) || { ui_cleanup; set +e; return 3; }
  trap ui_cleanup EXIT
  trap 'ui_cleanup; ui_progress_done "interrupted"; trap - EXIT; exit 130' INT TERM
  rm -rf "$UI_SHARDS_DIR"; mkdir -p "$UI_SHARDS_DIR"
  rm -f "$UI_PROGRESS_DIR/shard-0.line"; UI_N=$n
  plan=$(ui_balance "$n" "${suites[@]}")
  local mine
  for ((i = 1; i <= n; i++)); do
    mine=(); while read -r s; do mine+=("$s"); done < <(awk -v i="$i" '$1 == i { print $2 }' <<<"$plan")
    printf '%s\n' "${mine[@]}" >"$UI_SHARDS_DIR/shard-$i.suites"
    ui_shard "$i" "${UI_SIMS[i - 1]}" "$xr" "${mine[@]}" &
    UI_PIDS+=($!)
  done
  echo "dev: ui-test: ${#suites[@]} suites in $n shards on $(for udid in "${UI_SIMS[@]}"; do printf '%s, ' "$(sim_name_by_udid "$udid")"; done | sed 's/, $//')" >&2
  local rcs=()
  for ((i = 0; i < n; i++)); do wait "${UI_PIDS[i]}" && rcs+=(0) || rcs+=($?); done
  local sims=("${UI_SIMS[@]}")
  ui_cleanup # give the borrowed simulators back before the crash guard looks
  trap - EXIT INT TERM
  local bundle json total p f k rp tp=0 tf=0 tk=0 failed=0 log secs missing flaky=() id
  for ((i = 1; i <= n; i++)); do
    bundle="$UI_SHARDS_DIR/shard-$i.xcresult"; log="$LOGS/ui-test-shard$i-$$.log"
    json=$(xcrun xcresulttool get test-results summary --path "$bundle" --compact 2>/dev/null) || json="{}"
    total=$(jq '.totalTestCount // 0' <<<"$json" 2>/dev/null) || total=0
    p=$(jq '.passedTests // 0' <<<"$json" 2>/dev/null) || p=0
    f=$(jq '.failedTests // 0' <<<"$json" 2>/dev/null) || f=0
    k=$(jq '.skippedTests // 0' <<<"$json" 2>/dev/null) || k=0
    secs=$(cat "$UI_SHARDS_DIR/shard-$i.secs" 2>/dev/null || echo 0)
    if [[ -s "$UI_SHARDS_DIR/shard-$i.retried" ]]; then # failed in the shard, passed on an accepted retry: counts come from both bundles
      rp=$(xcrun xcresulttool get test-results summary --path "$UI_SHARDS_DIR/retry-$i.xcresult" --compact 2>/dev/null | jq '.passedTests // 0') || rp=0
      p=$((p + rp)); f=$((f - rp))
      while read -r id; do
        flaky+=("$id"); printf '%s %s %s\n' "$(date -u +%FT%TZ)" "$(git rev-parse --short HEAD)" "$id" >>"$UI_FLAKY_LOG"
        echo "dev: warning: flaky under load, failed then passed on retry: $id" >&2
      done <"$UI_SHARDS_DIR/shard-$i.retried"
    fi
    printf 'shard %d\t%s\t%d suites\t%d tests\t%s\n' "$i" "$(sim_name_by_udid "${sims[i - 1]}")" \
      "$(wc -l <"$UI_SHARDS_DIR/shard-$i.suites" | tr -d ' ')" "$total" "$(ui_fmt_secs "$secs")" >>"$UI_SHARDS_DIR/summary.tsv"
    # Every planned suite must have produced test cases: a suite that silently ran nothing is a failure.
    missing=$(comm -23 <(sort "$UI_SHARDS_DIR/shard-$i.suites") <(ui_bundle_suites "$bundle" | cut -f1 | sort) | tr '\n' ' ')
    if ((rcs[i - 1] != 0 || total == 0 || f > 0)) || [[ -n "$missing" ]]; then
      failed=1
      echo "FAILED: ui-test shard $i on $(sim_name_by_udid "${sims[i - 1]}") ($(tr '\n' ' ' <"$UI_SHARDS_DIR/shard-$i.suites" | sed 's/ $//')), full log: $log" >&2
      ((total > 0)) || echo "FAILED: ui-test — shard $i ran no tests" >&2
      [[ -z "$missing" ]] || echo "FAILED: ui-test — planned suites with no test cases in shard $i: $missing" >&2
      if (($(jq '(.testFailures // []) | length' <<<"$json" 2>/dev/null || echo 0) > 0)); then report_failures "$bundle"; else excerpt "$log" | cap >&2; fi
    fi
    tp=$((tp + p)); tf=$((tf + f)); tk=$((tk + k))
  done
  ((failed == 0)) || return 1
  total=$((tp + tf + tk))
  local last; last=$(cat "$UI_TOTAL" 2>/dev/null || echo 0)
  if ((total < last)) && [[ -z "${DEV_UI_ALLOW_FEWER:-}" ]]; then
    echo "FAILED: ui-test ran $total tests, fewer than the $last of the last passing run (a suite or test went missing; DEV_UI_ALLOW_FEWER=1 accepts it)" >&2
    return 1
  fi
  mkdir -p .build; echo "$total" >"$UI_TOTAL"
  ui_record_durations
  UI_FLAKY=""; if ((${#flaky[@]} > 0)); then UI_FLAKY=$(IFS=,; echo "${flaky[*]}"); fi
  # latest-ui-test.xcresult for `./dev coverage ui-test`: the shards (and accepted retries) merged, coverage included.
  local bundles=()
  while IFS= read -r b; do bundles+=("$b"); done < <(find "$UI_SHARDS_DIR" -maxdepth 1 -name '*.xcresult' | sort)
  rm -rf "$RESULTS/latest-ui-test.xcresult"
  xcrun xcresulttool merge "${bundles[@]}" --output-path "$RESULTS/latest-ui-test.xcresult" >/dev/null 2>&1 ||
    { echo "dev: warning: merging the shard bundles failed; coverage reads shard 1" >&2; cp -R "$UI_SHARDS_DIR/shard-1.xcresult" "$RESULTS/latest-ui-test.xcresult"; }
  [[ -z "${DEV_UI_VERBOSE:-}" ]] || cat "$UI_SHARDS_DIR/summary.tsv" >&2
  secs=$((SECONDS - t0))
  local line="ui-test: $tp passed, $tf failed, $tk skipped, ${#flaky[@]} flaky ($n shards, $( ((secs >= 60)) && echo "$(((secs + 30) / 60))m" || echo "${secs}s"))"
  echo "$line"
  ui_progress_done "$line"
}

# Progress of a running (or the last) ui-test, from the file the ui_progress_* functions keep up to date.
cmd_ui_status() {
  local pid=""
  pid=$(cat "$UI_PROGRESS_DIR/pid" 2>/dev/null || true)
  if [[ -s "$UI_PROGRESS" && -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    cat "$UI_PROGRESS"
    return 0
  fi
  echo "ui-test: not running"
  if [[ -f "$UI_STAMP" ]]; then
    echo "last stamp ($UI_STAMP):"; sed 's/^/  /' "$UI_STAMP"
  else
    echo "last stamp: none"
  fi
  if [[ -s "$UI_PROGRESS" ]]; then
    local last; last=$(tail -n 1 "$UI_PROGRESS")
    [[ "$last" == done:* ]] || last="(no final line: that run was cut off) $last"
    echo "last run: $last"
  else
    echo "last run: no progress file"
  fi
}

# Per-target code coverage of the newest passing `test` / `ui-test` run (tests record coverage; see run_tests).
cmd_coverage() {
  local kind="${1:-test}"
  case "$kind" in test | ui-test) ;; *) die "coverage: unknown kind '$kind' (usage: coverage [test|ui-test])" ;; esac
  local bundle="$RESULTS/latest-$kind.xcresult"
  [[ -d "$bundle" ]] || die "coverage: no $bundle yet; run ./dev $kind first (a passing run keeps its bundle)"
  xcrun xccov view --report --only-targets "$bundle"
}

cmd_kit() {
  [[ -d "$KIT" ]] || die "$KIT does not exist"
  if [[ -n "${1:-}" ]]; then
    run_logged kit bash -c 'cd "$1" && swift test --filter "$2"' _ "$KIT" "$1"
  else
    run_logged kit bash -c 'cd "$1" && swift test' _ "$KIT"
  fi
  kit_summary "${1:-}"
}

# Whole-package line coverage: swift test --enable-code-coverage, then the TOTAL row of llvm-cov's report.
cmd_kit_coverage() {
  [[ -d "$KIT" ]] || die "$KIT does not exist"
  run_logged kit-coverage bash -c 'cd "$1" && swift test --enable-code-coverage' _ "$KIT"
  kit_summary "" || return
  local json prof bin report
  json=$(cd "$KIT" && swift test --show-codecov-path)
  prof="$(dirname "$json")/default.profdata"
  [[ -f "$prof" ]] || die "kit-coverage: no profdata at $prof"
  local products; products=$(dirname "$(dirname "$json")") # .../Products/Debug, next to codecov/
  bin=$(find "$products" -maxdepth 1 -name '*.xctest' | head -n 1)
  [[ -d "$bin" ]] || die "kit-coverage: no .xctest bundle in $products"
  [[ -d "$bin/Contents/MacOS" ]] && bin="$bin/Contents/MacOS/$(basename "$bin" .xctest)"
  report=$(xcrun llvm-cov report "$bin" -instr-profile="$prof" 2>&1) || die "kit-coverage: llvm-cov failed: $report"
  grep '^TOTAL' <<<"$report" | awk '{ printf "kit coverage: lines %s (%d of %d), regions %s, functions %s\n", $10, $8 - $9, $8, $4, $7 }'
}

# swift test exits 0 when --filter matches nothing; turn that into a failure, else print the totals line.
swift_test_summary() { # swift_test_summary <label> <filter>; not test_summary, which is the xcodebuild one above
  local log="$LAST_LOG" line
  if grep -q 'No matching test cases were run' "$log"; then
    echo "FAILED: $1 — no tests matched filter '$2' (check the suite/test name)" >&2
    return 1
  fi
  line=$(grep -E 'Test run with .* passed' "$log" | tail -n 1 || true)
  if [[ -n "$line" ]]; then
    echo "$1: Test run with ${line#*Test run with }"
  else
    echo "$1: ok"
  fi
}
kit_summary() { swift_test_summary kit "$1"; } # kit_summary <filter>
cmd_kit_build() {
  [[ -d "$KIT" ]] || die "$KIT does not exist"
  run_logged kit-build bash -c 'cd "$1" && swift build' _ "$KIT"
}

swift_format() { # swift_format <lint --strict|format --in-place>
  xcrun swift-format "$@" --recursive --parallel "${LINT_PATHS[@]}"
}
cmd_lint() {
  local out rc=0
  out=$(swift_format lint --strict 2>&1) || rc=$?
  if ((rc != 0)); then
    echo "$out" | cap >&2
    echo "FAILED: lint (exit $rc). Fix with: ./dev format" >&2
  fi
  return "$rc"
}
cmd_format() { swift_format format --in-place; }

find_app() {
  local app
  # By name: after a ui-test run the folder also holds WorkoutsUITests-Runner.app, and `find -print -quit` returned it
  # first, so `run` installed the runner and launched a stale Workouts build (2026-11-03).
  app="$DERIVED/Build/Products/Debug-iphonesimulator/Workouts.app"
  [[ -d "$app" ]] || die "no Workouts.app under $DERIVED/Build/Products/Debug-iphonesimulator"
  echo "$app"
}

run_prepare() { # boot, build and install; leaves the launch to the caller (cmd_run, or cmd_shot --burst to catch the first frames)
  local out
  sim_resolve
  # Boots headless: no Simulator.app window is opened (with a pool of simulators, windows pile up on Eric's Mac).
  if out=$(xcrun simctl boot "$SIM_UDID" 2>&1); then
    COLD_BOOT=1 # a fresh boot (or a new clone) needs longer before its first frame; cmd_shot waits for it
  else
    [[ "$out" == *"current state: Booted"* || "$out" == *"already"* ]] || die "boot failed: $out"
  fi
  xcrun simctl bootstatus "$SIM_UDID" -b >/dev/null 2>&1 || true
  cmd_build
  xcrun simctl install "$SIM_UDID" "$(find_app)"
}

cmd_run() { # cmd_run [-- app launch args...]; args reach the app, e.g. ./dev run -- -preview Swatches
  [[ "${1:-}" == "--" ]] && shift
  run_prepare
  xcrun simctl launch --terminate-running-process "$SIM_UDID" "$BUNDLE_ID" "$@"
  echo "logs: xcrun simctl spawn $SIM_UDID log stream --predicate 'subsystem == \"$BUNDLE_ID\"'"
}

cmd_screenshot() {
  local path="${1:-.build/screenshots/$(date +%Y%m%d-%H%M%S).png}"
  mkdir -p "$(dirname "$path")"
  # Multi-display devices (iPhone Duo) need --display; DEV_DISPLAY overrides the "primary" fallback.
  local out
  if ! out=$(xcrun simctl io "$SIM_UDID" screenshot "$path" 2>&1); then
    if [[ "$out" == *"--display"* ]]; then
      out=$(xcrun simctl io "$SIM_UDID" screenshot --display="${DEV_DISPLAY:-primary}" "$path" 2>&1) || die "screenshot failed: $out"
    else
      die "screenshot failed: $out"
    fi
  fi
  echo "$path"
}

cmd_shot() { # cmd_shot <png> [-- app launch args...]: run + settle + screenshot under ONE lock hold
  # Separate `run` and `screenshot` calls each take the lock, so a parallel worker could install its own build in between
  # and the shot would show that build (seen 2026-11-03). A cold boot waits 15 s for the first frame; then `duo screenshot
  # --settle` captures the lit panel every 300 ms until two consecutive captures are byte-identical (timeout
  # ${DEV_SETTLE_TIMEOUT:-10} s, fails when the app never stops redrawing), and that settled capture is the PNG.
  # DEV_SETTLE=<s> is an optional extra wait before settling (default 1 s, so a still launch screen is not mistaken
  # for the settled app).
  local burst=0 burst_spec=""
  if [[ "${1:-}" == --burst ]]; then
    burst=1; shift
    if [[ "${1:-}" =~ ^[0-9]+x[0-9]+$ ]]; then burst_spec="$1"; shift; fi
  fi
  local path="${1:-}"
  [[ -n "$path" && "$path" != -* ]] || die "usage: shot [--burst [<count>x<intervalMs>]] <png> [-- app args...]"
  shift
  [[ "${1:-}" == "--" ]] && shift
  if ((burst)); then cmd_shot_burst "$path" "$burst_spec" "$@"; return; fi
  cmd_run -- "$@" >/dev/null
  sleep "${DEV_SETTLE:-$((COLD_BOOT ? 15 : 1))}"
  duo_bin
  mkdir -p "$(dirname "$path")"
  # The status bar clock and indicators change between runs, so pin them (documented simctl) for the capture only.
  xcrun simctl status_bar "$SIM_UDID" override --time 9:41 --wifiBars 3 --cellularMode notSupported \
    --batteryState charged --batteryLevel 100 >/dev/null 2>&1 || true
  local rc=0
  "$DUO_BIN" screenshot "$path" --settle --timeout "${DEV_SETTLE_TIMEOUT:-10}" --udid "$SIM_UDID" || rc=$?
  xcrun simctl status_bar "$SIM_UDID" clear >/dev/null 2>&1 || true
  ((rc == 0)) || die "shot: no settled screenshot"
  echo "$path"
}

cmd_shot_burst() { # cmd_shot_burst <png> <spec|""> [app launch args...]: capture the lit panel from the moment of launch
  # A reviewer artifact for transitions (pushed screens, first frames), not a settled proof: duo captures the lit panel
  # <count> times about <intervalMs> apart (default 15x100) and tiles the frames into <png>, each labelled with its
  # index and time offset. The app launch runs in the background so the burst's first frames are the launch itself.
  # No tap injection: Tools/duo has no tap primitive (its HID code only moves the hinge).
  local path="$1" spec="$2"
  shift 2
  run_prepare
  duo_bin
  mkdir -p "$(dirname "$path")"
  ((COLD_BOOT)) && sleep 15 # a fresh boot needs time before its first frame, as for a settled shot
  xcrun simctl status_bar "$SIM_UDID" override --time 9:41 --wifiBars 3 --cellularMode notSupported \
    --batteryState charged --batteryLevel 100 >/dev/null 2>&1 || true
  xcrun simctl launch --terminate-running-process "$SIM_UDID" "$BUNDLE_ID" "$@" >/dev/null &
  local launch_pid=$! rc=0
  "$DUO_BIN" screenshot "$path" --burst ${spec:+"$spec"} --udid "$SIM_UDID" || rc=$?
  wait "$launch_pid" || echo "dev: shot --burst: app launch failed" >&2
  xcrun simctl status_bar "$SIM_UDID" clear >/dev/null 2>&1 || true
  ((rc == 0)) || die "shot --burst: no burst captured"
  echo "$path"
}

# Simulator commands hold the lock of their one simulator (see the pool above), so parallel agents on the same simulator
# take turns instead of racing it, and fail when any simulator process crashed while they ran. The crash check is global:
# a crash on any simulator fails the command. Seen 2026-11-03: a SpringBoard crash loop after
# `simctl io screenConfig --display=N power off` (now forbidden) and a PosterBoard crash while xcodebuild booted a
# parallel-testing clone. Each crash raises a "quit unexpectedly" dialog on Eric's Mac.
CRASH_DIR="${DEV_CRASH_DIR:-$HOME/Library/Logs/DiagnosticReports}"
SIM_LOCK=""
sim_lock() { # sim_lock <lock-dir>
  SIM_LOCK="$1"
  local waited=0 owner
  until mkdir "$SIM_LOCK" 2>/dev/null; do
    owner=$(cat "$SIM_LOCK/pid" 2>/dev/null || true)
    if [[ -n "$owner" ]] && ! kill -0 "$owner" 2>/dev/null; then sim_reclaim "$SIM_LOCK" "$owner"; continue; fi
    ((waited % 30 == 0)) && echo "dev: waiting for $SIM_NAME (held by pid ${owner:-?})" >&2
    sleep 2; waited=$((waited + 2))
    ((waited < 1800)) || die "simulator lock held for 30 min by pid ${owner:-?}; remove $SIM_LOCK if it is stale"
  done
  echo $$ >"$SIM_LOCK/pid"
  trap sim_release EXIT
}
# Releasing a lock stamps the simulator as used just now (<lock>.lock -> <lock>.last-used); the idle reaper reads the stamp.
sim_stamp_path() { local lock; lock=$(sim_lock_path "$1"); echo "${lock%.lock}.last-used"; } # sim_stamp_path <udid>
sim_release() { [[ -z "$SIM_LOCK" ]] || { touch "${SIM_LOCK%.lock}.last-used" 2>/dev/null || true; rm -rf "$SIM_LOCK"; }; }
sim_unlock() { sim_release; trap - EXIT; }

# Pool housekeeping. These take a simulator's lock without waiting (sim_grab fails when anyone holds it, so a run in
# progress is never disturbed) and give it back with sim_drop, which also stamps it used.
# Remove a lock whose owner is dead. A plain `rm -rf` races: a second waiter could delete the lock a first one has just
# re-created. mv is atomic, so one waiter wins the dead directory; if what it moved is no longer the dead owner's lock
# (someone re-took it between our read and our mv), it puts it back.
sim_reclaim() { # sim_reclaim <lock-dir> <dead-owner-pid>
  local dead="$1.dead.$$" now
  mv "$1" "$dead" 2>/dev/null || return 0
  now=$(cat "$dead/pid" 2>/dev/null || true)
  if [[ "$now" != "$2" && -n "$now" ]] && kill -0 "$now" 2>/dev/null; then mv -n "$dead" "$1" 2>/dev/null || true; fi
  rm -rf "$dead"
}
sim_grab() { # sim_grab <udid>
  [[ "$1" == "$SIM_UDID" && -n "$SIM_LOCK" ]] && return 0 # this command already holds it
  local dir owner; dir=$(sim_lock_path "$1")
  sim_lock_free "$1" || return 1
  if [[ -d "$dir" ]]; then owner=$(cat "$dir/pid" 2>/dev/null || true); sim_reclaim "$dir" "$owner"; fi
  mkdir "$dir" 2>/dev/null || return 1
  echo $$ >"$dir/pid"
}
sim_drop() { # sim_drop <udid>
  [[ "$1" == "$SIM_UDID" && -n "$SIM_LOCK" ]] && return 0
  touch "$(sim_stamp_path "$1")" 2>/dev/null || true
  rm -rf "$(sim_lock_path "$1")"
}
sim_is_clone() { # a pool member other than the original (the only simulators dev may erase on its own)
  local n; n=$(sim_name_by_udid "$1")
  [[ -n "$n" && "$n" != "$SIM_ORIGINAL" ]] && sim_pool_names | grep -qxF "$n"
}
sim_idle_min() { # minutes since a simulator was last used: newest of its last-used stamp, lock dir and claim files
  local udid="$1" newest=0 f m
  for f in "$(sim_lock_path "$udid")" "$(sim_stamp_path "$udid")"; do
    m=$(stat -f %m "$f" 2>/dev/null || echo 0); ((m > newest)) && newest=$m
  done
  while IFS= read -r f; do
    [[ "$(cat "$f" 2>/dev/null || true)" == "$udid" ]] || continue
    m=$(stat -f %m "$f" 2>/dev/null || echo 0); ((m > newest)) && newest=$m
  done < <(sim_claim_files)
  # Never seen in use (booted before stamps existed, or by hand): start its clock now rather than reap it blind.
  if ((newest == 0)); then touch "$(sim_stamp_path "$udid")" 2>/dev/null || true; echo 0; return; fi
  echo $((($(date +%s) - newest) / 60))
}
# Simulators this command holds: its own plus any shard simulators it borrowed (ui_pick_sims appends to $SIM_HELD_FILE).
SIM_HELD_FILE=""
sim_held() { [[ "$1" == "$SIM_UDID" ]] || { [[ -n "$SIM_HELD_FILE" ]] && grep -qxF "$1" "$SIM_HELD_FILE" 2>/dev/null; }; }
# Another checkout's claim keeps its simulator off limits (to erase, heal or borrow) until that claim has gone $SIM_IDLE_MIN
# minutes without being refreshed, i.e. the simulator has sat idle. Simulators this command holds are always ours.
sim_hands_off() { # sim_hands_off <udid>: another checkout's claim on it was refreshed within $SIM_IDLE_MIN minutes
  sim_held "$1" && return 1
  local f
  while IFS= read -r f; do
    [[ "$f" -ef "$SIM_CLAIM" ]] && continue
    [[ "$(cat "$f" 2>/dev/null || true)" == "$1" ]] || continue
    [[ -n "$(find "$f" -mmin "-$SIM_IDLE_MIN" 2>/dev/null)" ]] && return 0
  done < <(sim_claim_files)
  return 1
}
sim_app_running() { # the app is running on a booted simulator: someone is mid-flow even if no dev command holds the lock
  local out; out=$(xcrun simctl spawn "$1" launchctl list 2>/dev/null || true)
  [[ "$out" == *com.ericribeiro.Workouts* ]]
}
sim_reap_idle() { # shut down booted pool simulators nobody holds and nobody used for $SIM_IDLE_MIN minutes (never the original)
  ((SIM_IDLE_MIN > 0)) || return 0
  local name udid idle
  while IFS= read -r name; do
    [[ "$name" != "$SIM_ORIGINAL" ]] || continue
    udid=$(sim_udid_by_name "$name")
    [[ -n "$udid" && "$udid" != "$SIM_UDID" && "$(sim_state_by_udid "$udid")" == "Booted" ]] || continue
    sim_lock_free "$udid" || continue
    idle=$(sim_idle_min "$udid"); ((idle >= SIM_IDLE_MIN)) || continue
    sim_app_running "$udid" && continue
    sim_grab "$udid" || continue
    xcrun simctl shutdown "$udid" >/dev/null 2>&1 || true
    sim_drop "$udid"
    echo "dev: shut down idle $name (idle $idle min)" >&2
  done < <(sim_pool_names)
}
sim_heal() { # sim_heal <udid> <crash-count>: shut down and erase a pool clone whose system processes are crash-looping
  local name; name=$(sim_name_by_udid "$1")
  sim_hands_off "$1" && { echo "dev: $name crashed system processes ($2 reports) but another checkout claims it; not erasing it" >&2; return 0; }
  sim_grab "$1" || { echo "dev: $name crashed system processes ($2 reports) but is in use; not erasing it" >&2; return 0; }
  xcrun simctl shutdown "$1" >/dev/null 2>&1 || true
  xcrun simctl erase "$1" >/dev/null 2>&1 || echo "dev: erase of $name failed" >&2
  sim_drop "$1"
  echo "dev: shut down and erased $name after $2 system-process crash reports; it boots clean on the next run" >&2
}
sim_crashes() { # sim_crashes <since-epoch>: "<fatal|warn> <report> <udid|-> <process>" per crash report captured after <since-epoch>
  # Reads each report's own captureTime (files are sometimes re-touched long after the crash) and skips daemons killed
  # while a simulator shuts down (SIGTERM timeout), which are shutdown noise, not crashes.
  /usr/bin/python3 -I - "$CRASH_DIR" "$1" <<'PY'
import datetime, json, os, re, sys
root, since = sys.argv[1], float(sys.argv[2])
for name in sorted(os.listdir(root)):
    path = os.path.join(root, name)
    if not name.endswith(".ips") or os.path.getmtime(path) < since:
        continue
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
        body = json.loads(text[text.index("\n") + 1:])
        captured = datetime.datetime.strptime(body["captureTime"][:19], "%Y-%m-%d %H:%M:%S").timestamp()
    except Exception:
        continue
    if captured < since - 1 or "CoreSimulator.SimDevice" not in body.get("coalitionName", ""):
        continue
    if "SIGTERM_TIMEOUT" in json.dumps(body.get("termination", {})):
        continue
    proc = body.get("procName", name.split("-")[0])
    # Fatal: our own processes (a real bug) and the processes whose crash loops flood the Mac with dialogs.
    fatal = proc in {"Workouts", "WorkoutsLiveActivity", "SpringBoard", "PosterBoard", "backboardd"}
    # An extension relaunched from the bundle a reinstall just moved to containermanagerd's Dead/ folder crashes in
    # ExtensionFoundation before any of our code runs (a Live Activity was still up during the install): install noise.
    if fatal and "/com.apple.containermanagerd/System/Dead/" in body.get("procPath", ""):
        fatal = False
    # The coalition name carries the simulator's UDID (com.apple.CoreSimulator.SimDevice.<udid>).
    udid = re.search(r"SimDevice\.([0-9A-Fa-f-]{36})", body.get("coalitionName", ""))
    print(("fatal " if fatal else "warn ") + name + " " + (udid.group(1).upper() if udid else "-") + " " + proc)
PY
}
sim_guarded() { # sim_guarded <cmd> [args...]
  local rc=0 crashes held
  sim_resolve
  sim_lock "$(sim_lock_path "$SIM_UDID")"
  SIM_HELD_FILE=$(mktemp); echo "$SIM_UDID" >"$SIM_HELD_FILE"
  local since; since=$(date +%s)
  # Not `"$@" || rc=$?`: bash disables `set -e` inside anything run in a `||` context, so check kept going past a
  # failed step and printed "check: ok" (2026-11-03). A subshell with errexit re-enabled stops at the first failure.
  set +e
  (set -e; "$@")
  rc=$?
  set -e
  crashes=$(sim_crashes "$since")
  # Fail only for crashes on the simulators this command held. Everything else (other simulators, which other agents
  # are running right now, and daemons like assetsd or intelligencetasksd that crash on their own) is a warning.
  held=" $(tr '\n' ' ' <"$SIM_HELD_FILE") "
  crashes=$(awk -v held="$held" '$1 == "fatal" && $3 != "-" && index(held, " " $3 " ") == 0 { $1 = "warn" } { print }' <<<"$crashes")
  grep '^warn ' <<<"$crashes" | awk '{ print "dev: warning: simulator process crashed (not on our simulators, or a daemon): " $2 }' >&2 || true
  crashes=$(grep '^fatal ' <<<"$crashes" || true)
  if [[ -n "$crashes" ]]; then
    echo "dev: a simulator process crashed during this command:" >&2
    awk '{ print "dev:   " $2 }' <<<"$crashes" >&2
    # A pool clone whose system processes (PosterBoard, SpringBoard, backboardd) crashed twice is wedged: reset it. The
    # original is never erased automatically, and a clone someone else is running is left alone.
    local udid n
    while read -r udid n; do
      sim_is_clone "$udid" && sim_heal "$udid" "$n"
    done < <(awk '$4 ~ /^(PosterBoard|SpringBoard|backboardd)$/ && $3 != "-" { c[$3]++ } END { for (u in c) if (c[u] >= 2) print u, c[u] }' <<<"$crashes")
    echo "dev: stop and report it; do not keep testing, and never run 'simctl shutdown all' (other agents' simulators). Reports: $CRASH_DIR" >&2
    rm -f "$SIM_HELD_FILE"
    exit 1
  fi
  rm -f "$SIM_HELD_FILE"
  return "$rc"
}

# Duo poses (hinge fold, rotation, Home) come from Tools/duo, our own SwiftPM tool: a vendor HID event, the same one Xcode's
# Device Hub sends, moves the simulated hinge or orientation from a small helper inside the simulator, and every pose is
# verified by documented reads (CoreMotion hinge angle, `devicectl` orientation and lit panel) before the command succeeds.
# Verified with zero SpringBoard crashes, unlike `simctl io screenConfig` display toggling (forbidden). Stateless: no
# daemon and no session to leak, so the per-simulator lock in sim_guarded is all the serialisation there is.
# See docs/plan-device-tool.md. SwiftPM keeps its own scratch-path lock, so concurrent builds are safe.
sim_require_booted() { [[ "$(xcrun simctl list devices booted)" == *"$SIM_UDID"* ]] || die "$SIM_NAME is not booted; ./dev run first"; }
duo_bin() { # build Tools/duo in release mode unless the binary is newer than every source file under it
  if [[ -x "$DUO_BIN" ]] && [[ -z "$(find Tools/duo -name .build -prune -o -type f -newer "$DUO_BIN" -print -quit)" ]]; then
    return 0
  fi
  echo "dev: building Tools/duo…" >&2
  run_logged duo-build swift build -c release --package-path Tools/duo --scratch-path "$DUO_SPM" || die "duo build failed"
}
duo_png_ok() { [[ -z "${1:-}" || "$1" != -* ]]; } # an optional png path must not look like an option
cmd_home() { # go to the Home screen so the Live Activity / notifications show; a png is a capture of it
  duo_png_ok "${1:-}" || die "usage: home [screenshot.png]"
  sim_require_booted; duo_bin
  local extra=(); if [[ -n "${1:-}" ]]; then mkdir -p "$(dirname "$1")"; extra=(--png "$1"); fi
  "$DUO_BIN" home --udid "$SIM_UDID" ${extra[@]+"${extra[@]}"}
}
cmd_fold() {
  if [[ "${1:-}" == --keyframes ]]; then # timed hinge motion, optionally recorded (docs/plan-device-tool.md C.5)
    [[ -n "${2:-}" && "$2" != -* ]] || die "usage: fold --keyframes '<json>' [--record <movie.mov>]"
    local json="$2" extra=()
    shift 2
    if [[ "${1:-}" == --record ]]; then
      [[ -n "${2:-}" && "$2" != -* ]] || die "usage: fold --keyframes '<json>' [--record <movie.mov> [--display lit|outer|inner]]"
      mkdir -p "$(dirname "$2")"; extra=(--record "$2"); shift 2
      if [[ "${1:-}" == --display ]]; then
        [[ "${2:-}" =~ ^(lit|outer|inner)$ ]] || die "usage: fold --keyframes '<json>' [--record <movie.mov> [--display lit|outer|inner]]"
        extra+=(--display "$2"); shift 2
      fi
      [[ $# -eq 0 ]] || die "usage: fold --keyframes '<json>' [--record <movie.mov> [--display lit|outer|inner]]"
    else
      [[ $# -eq 0 ]] || die "usage: fold --keyframes '<json>' [--record <movie.mov>]"
    fi
    sim_require_booted; duo_bin
    "$DUO_BIN" fold --keyframes "$json" --udid "$SIM_UDID" ${extra[@]+"${extra[@]}"}
    return
  fi
  [[ "${1:-}" =~ ^(closed|half-open|open)$ ]] && duo_png_ok "${2:-}" || die "usage: fold closed|half-open|open [screenshot.png]"
  sim_require_booted; duo_bin
  local extra=(); if [[ -n "${2:-}" ]]; then mkdir -p "$(dirname "$2")"; extra=(--png "$2"); fi
  "$DUO_BIN" fold "$1" --udid "$SIM_UDID" ${extra[@]+"${extra[@]}"}
}
cmd_orient() {
  [[ "${1:-}" =~ ^(portrait|landscape-left|landscape-right)$ ]] && duo_png_ok "${2:-}" || die "usage: orient portrait|landscape-left|landscape-right [screenshot.png]"
  sim_require_booted; duo_bin
  local extra=(); if [[ -n "${2:-}" ]]; then mkdir -p "$(dirname "$2")"; extra=(--png "$2"); fi
  "$DUO_BIN" orient "$1" --udid "$SIM_UDID" ${extra[@]+"${extra[@]}"}
}
cmd_pose() { # fold + orient + verify in one call; the names are the layouts verify-ui checks (docs/plan-device-tool.md C.1)
  [[ "${1:-}" =~ ^(closed-portrait|closed-landscape|open-wide|open-tall)$ ]] && duo_png_ok "${2:-}" \
    || die "usage: pose closed-portrait|closed-landscape|open-wide|open-tall [screenshot.png]"
  sim_require_booted; duo_bin
  local extra=(); if [[ -n "${2:-}" ]]; then mkdir -p "$(dirname "$2")"; extra=(--png "$2" --settle); fi
  "$DUO_BIN" pose "$1" --udid "$SIM_UDID" ${extra[@]+"${extra[@]}"}
}
cmd_poses() { # cmd_poses <dir> [-- app launch args...]: run + the four poses as settled PNGs, ONE lock hold (plan C.3)
  # Like cmd_shot, run and capture share one lock hold so no parallel worker installs its build in between. `duo poses`
  # writes <dir>/closed-portrait.png, closed-landscape.png, open-wide.png and open-tall.png (each settled; timeout
  # ${DEV_SETTLE_TIMEOUT:-10} s per capture) and always ends with the hinge closed and the device portrait, even after a
  # failure midway (it then exits non-zero). DEV_SETTLE is the same optional extra wait before the first capture as for shot.
  local dir="${1:-}"
  [[ -n "$dir" && "$dir" != -* ]] || die "usage: poses <dir> [-- app args...]"
  shift
  cmd_run "$@" >/dev/null
  sleep "${DEV_SETTLE:-$((COLD_BOOT ? 15 : 1))}"
  sim_require_booted; duo_bin
  mkdir -p "$dir"
  # The status bar clock and indicators change between runs, so pin them (documented simctl) for the captures only.
  xcrun simctl status_bar "$SIM_UDID" override --time 9:41 --wifiBars 3 --cellularMode notSupported \
    --batteryState charged --batteryLevel 100 >/dev/null 2>&1 || true
  local rc=0
  "$DUO_BIN" poses "$dir" --timeout "${DEV_SETTLE_TIMEOUT:-10}" --udid "$SIM_UDID" || rc=$?
  xcrun simctl status_bar "$SIM_UDID" clear >/dev/null 2>&1 || true
  ((rc == 0)) || die "poses: the set failed (closed-portrait was restored)"
}
cmd_duo() { # pass-through to the tool; adds --udid for the verbs that act on a simulator
  duo_bin
  local args=("$@") verb="${1:-}" a has_udid=0
  for a in "$@"; do [[ "$a" == --udid || "$a" == --udid=* ]] && has_udid=1; done
  case "$verb" in
    panels | screenshot | settle | hinge | fold | orient | pose | poses | home)
      ((has_udid == 0)) || die "pass the simulator as DEV_SIM_UDID=<udid> ./dev duo ..., not --udid (the lock and crash guard follow DEV_SIM/DEV_SIM_UDID)"
      sim_require_booted; args+=(--udid "$SIM_UDID") ;;
  esac
  "$DUO_BIN" ${args[@]+"${args[@]}"}
}
cmd_duo_test() { # Tools/duo's own tests (host-only, sub-second); quiet on success with one totals line
  run_logged duo-test swift test --package-path Tools/duo --scratch-path "$DUO_SPM" || return
  swift_test_summary duo ""
}

# PosterBoard crash-looped on a clone whose PosterKit temp folder had grown to thousands of entries (2026-11-05). Erase such a
# shut-down clone; the original is only reported, never erased automatically.
sim_erase_poster_buildup() {
  local name udid dir n
  while IFS= read -r name; do
    udid=$(sim_udid_by_name "$name"); [[ -n "$udid" && "$(sim_state_by_udid "$udid")" == "Shutdown" ]] || continue
    dir="$HOME/Library/Developer/CoreSimulator/Devices/$udid/data/Library/Application Support/com.apple.PosterKit/temp"
    n=$( { find "$dir" -mindepth 1 -maxdepth 1 2>/dev/null || true; } | wc -l | tr -d ' ')
    ((n > SIM_POSTER_MAX)) || continue
    if ! sim_is_clone "$udid"; then
      echo "dev: warning: $name has $n PosterKit temp entries (limit $SIM_POSTER_MAX); it is the original, so it is not erased." >&2
      echo "dev:   by hand, with no run using it (clones are copies of it): xcrun simctl erase $udid" >&2
      continue
    fi
    sim_hands_off "$udid" && continue
    sim_grab "$udid" || continue
    xcrun simctl erase "$udid" >/dev/null 2>&1 || echo "dev: erase of $name failed" >&2
    sim_drop "$udid"
    echo "dev: erased $name ($n PosterKit temp entries, limit $SIM_POSTER_MAX)" >&2
  done < <(sim_pool_names)
}

cmd_sims() { # create any missing pool clone, then list the pool; --prune also reaps idle sims and erases poster build-up
  [[ "${1:-}" == "" || "$1" == "--prune" ]] || die "usage: sims [--prune]"
  sim_table_load
  local orig name need=()
  orig=$(sim_udid_by_name "$SIM_ORIGINAL"); [[ -n "$orig" ]] || die "no simulator named '$SIM_ORIGINAL' to clone"
  while IFS= read -r name; do
    [[ -n "$(sim_udid_by_name "$name")" ]] || need+=("$name")
  done < <(sim_pool_names)
  if ((${#need[@]} > 0)); then
    SIM_NAME="$SIM_ORIGINAL" # clone needs the original shut down: hold its lock so nobody is mid-run on it
    sim_lock "$(sim_lock_path "$orig")"
    xcrun simctl shutdown "$orig" >/dev/null 2>&1 || true # errors when it is already shut down
    for name in "${need[@]}"; do
      echo "dev: cloning $SIM_ORIGINAL -> $name" >&2
      xcrun simctl clone "$orig" "$name" >/dev/null || die "clone to '$name' failed"
    done
    sim_unlock
    sim_table_load
  fi
  if [[ "${1:-}" == "--prune" ]]; then sim_reap_idle; sim_erase_poster_buildup; fi
  local mine; mine=$(cat "$SIM_CLAIM" 2>/dev/null || true)
  printf '%-14s %-36s %-9s %-5s %s\n' NAME UDID STATE LOCK THIS-CHECKOUT
  while IFS= read -r name; do
    local udid; udid=$(sim_udid_by_name "$name")
    if [[ -z "$udid" ]]; then printf '%-14s %s\n' "$name" "(missing; run ./dev sims)"; continue; fi
    printf '%-14s %-36s %-9s %-5s %s\n' "$name" "$udid" "$(sim_state_by_udid "$udid")" "$(sim_lock_holder "$udid")" \
      "$([[ "$udid" == "$mine" ]] && echo yes || echo -)"
  done < <(sim_pool_names)
}

# Signed App Store Connect export (TestFlight). Needs the App Store Connect API key in 1Password (read with `op`, which
# works headless through the service account). The key is streamed from `op read` straight into a 0600 file in a private
# temp directory under $TMPDIR: never into a shell variable, an environment variable, a command-line argument or a log.
# Only the file PATH reaches xcodebuild. A trap deletes the directory on EXIT, INT, TERM and HUP. Does not use the
# simulator, so no sim_guarded.
TF_DIR=".build/testflight"
TF_TEAM="S8Y5FT7937"
TF_TMP=""
# `testflight --upload` ships only a commit whose full ./dev ui-test passed (stamp written by cmd_ui_test).
tf_ui_gate() {
  if [[ "${DEV_SKIP_UI_GATE:-}" == 1 ]]; then
    echo "dev: WARNING: DEV_SKIP_UI_GATE=1, uploading without a passing ./dev ui-test on this commit" >&2
    return 0
  fi
  local head stamp_commit="" stamp_clean=""
  head=$(git rev-parse HEAD)
  if [[ -f "$UI_STAMP" ]]; then
    stamp_commit=$(sed -n 's/^commit=//p' "$UI_STAMP")
    stamp_clean=$(sed -n 's/^clean=//p' "$UI_STAMP")
  fi
  [[ "$stamp_commit" == "$head" && "$stamp_clean" == 1 ]] ||
    die "testflight: refusing to upload: run ./dev ui-test on this commit first (full suite, clean tree; stamp: ${stamp_commit:-none}${stamp_commit:+, clean=$stamp_clean}, HEAD: $head). DEV_SKIP_UI_GATE=1 overrides."
  local stamp_flaky; stamp_flaky=$(sed -n 's/^flaky=//p' "$UI_STAMP" | head -1)
  echo "dev: testflight: the ui-test stamp's flaky tests: ${stamp_flaky:-none recorded}" >&2
}
tf_cleanup() { [[ -z "$TF_TMP" ]] || rm -rf "$TF_TMP"; TF_TMP=""; }

cmd_testflight() {
  { set +x; } 2>/dev/null # never trace this function: a traced command line could carry key material
  local upload=0
  case "${1:-}" in
    "") ;;
    --upload) upload=1 ;;
    *) die "testflight: unknown argument '$1' (usage: testflight [--upload])" ;;
  esac
  # The gate runs before anything touches 1Password or the archive.
  ((upload == 0)) || tf_ui_gate
  command -v op >/dev/null 2>&1 || die "testflight: the 1Password CLI (op) is not installed"

  local key_id issuer_id build
  key_id=$(op read "op://Homelab/Apple App Store Connect API/key id" 2>/dev/null) || die "testflight: could not read the key id from 1Password"
  issuer_id=$(op read "op://Homelab/Apple App Store Connect API/issuer id" 2>/dev/null) || die "testflight: could not read the issuer id from 1Password"
  [[ -n "$key_id" && -n "$issuer_id" ]] || die "testflight: an App Store Connect API id is empty"

  trap tf_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  umask 077
  TF_TMP=$(mktemp -d "${TMPDIR:-/tmp}/workouts-testflight.XXXXXX") || die "testflight: mktemp failed"
  local key_file="$TF_TMP/AuthKey_${key_id}.p8"
  # The vault stores the PEM on one line, spaces where the newlines were. Keep the BEGIN/END markers, strip every space
  # from the body and re-wrap it at 64 columns. The key only ever flows through this pipe into the file.
  if ! op read "op://Homelab/Apple App Store Connect API/auth key" 2>/dev/null | awk '
      { s = s $0 }
      END {
        gsub(/-----BEGIN PRIVATE KEY-----/, "", s); gsub(/-----END PRIVATE KEY-----/, "", s); gsub(/[ \t\r]/, "", s)
        if (s == "") exit 1
        print "-----BEGIN PRIVATE KEY-----"
        for (i = 1; i <= length(s); i += 64) print substr(s, i, 64)
        print "-----END PRIVATE KEY-----"
      }' >"$key_file"; then
    die "testflight: could not read the auth key from 1Password"
  fi
  chmod 600 "$key_file"
  openssl pkey -in "$key_file" -noout >/dev/null 2>&1 || die "testflight: the auth key from 1Password is not a valid PEM"

  build=$(date -u +%Y%m%d%H%M)
  local archive="$TF_DIR/Workouts.xcarchive" plist="$TF_DIR/ExportOptions.plist" export_dir="$TF_DIR/export"
  local auth=(-allowProvisioningUpdates -authenticationKeyPath "$key_file" -authenticationKeyID "$key_id"
    -authenticationKeyIssuerID "$issuer_id")
  rm -rf "$archive" "$export_dir"
  mkdir -p "$TF_DIR"

  # Archive with development signing from the Xcode account on this Mac (Apple ID in Xcode > Settings > Accounts, the
  # registered Duo, keychain access approved once): that keeps the entitlements (iCloud, time-sensitive), which an unsigned
  # archive loses. The API key is not accepted for development provisioning ("Authentication failed"), so it is used only
  # by the export/upload below, which re-signs for App Store distribution with cloud-managed certificates (JC48, JC55).
  run_logged testflight-archive xcodebuild archive -scheme "$SCHEME" -destination 'generic/platform=iOS' \
    -archivePath "$archive" -derivedDataPath "$TF_DIR/DerivedData" -quiet -allowProvisioningUpdates CURRENT_PROJECT_VERSION="$build" \
    || return

  local destination=export
  ((upload == 0)) || destination=upload
  cat >"$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>$TF_TEAM</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>destination</key>
	<string>$destination</string>
</dict>
</plist>
PLIST

  run_logged testflight-export xcodebuild -exportArchive -archivePath "$archive" -exportOptionsPlist "$plist" \
    -exportPath "$export_dir" "${auth[@]}" || return

  if ((upload == 1)); then
    echo "testflight: uploaded build $build"
  else
    local ipa; ipa=$(find "$export_dir" -maxdepth 1 -name '*.ipa' | head -n 1)
    [[ -n "$ipa" ]] || die "testflight: export produced no .ipa in $export_dir"
    echo "testflight: build $build $ipa"
  fi
}

# Uploads exercise videos to CloudKit's public database (Web Services, server-to-server key; docs/port/media.md). The key
# handling mirrors cmd_testflight: streamed from `op read` into a 0600 file in a private temp directory a trap deletes,
# never into a variable, environment variable, argument or log. Only the key FILE path reaches the Python script, which
# signs by running `openssl dgst -sha256 -sign <file>`. Does not use the simulator, so no sim_guarded.
MU_TMP=""
mu_cleanup() { [[ -z "$MU_TMP" ]] || rm -rf "$MU_TMP"; MU_TMP=""; }

cmd_media_upload() {
  { set +x; } 2>/dev/null # never trace this function: a traced command line could carry key material
  local env=development limit=0 only="" lookup=0
  local usage="usage: media-upload [--env development|production] [--limit N] [--only <sourceId>] [--lookup]"
  while (($#)); do
    case "$1" in
      --lookup) lookup=1; shift ;; # read-only: print each stored asset's size and download host (with --only or --limit)
      --env) [[ "${2:-}" =~ ^(development|production)$ ]] || die "media-upload: $usage"; env="$2"; shift 2 ;;
      --limit) [[ "${2:-}" =~ ^[0-9]+$ ]] || die "media-upload: $usage"; limit="$2"; shift 2 ;;
      --only) [[ -n "${2:-}" && "$2" != -* && "$2" != */* ]] || die "media-upload: $usage"; only="$2"; shift 2 ;;
      *) die "media-upload: unknown argument '$1' ($usage)" ;;
    esac
  done
  local media_dir="${MEDIA_DIR:-$HOME/Server/docker-volumes/workouts/snapshot/media}"
  [[ -d "$media_dir" ]] || die "media-upload: $media_dir does not exist"
  command -v op >/dev/null 2>&1 || die "media-upload: the 1Password CLI (op) is not installed"

  local key_id
  # Server-to-server keys are per environment: the 1Password item has a development and a production section.
  local item="op://Homelab/Apple Cloud Kit for Workouts Duo/$env"
  key_id=$(op read "$item/key id" 2>/dev/null) || die "media-upload: could not read the key id from 1Password"
  [[ -n "$key_id" ]] || die "media-upload: the CloudKit key id is empty"

  trap mu_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  umask 077
  MU_TMP=$(mktemp -d "${TMPDIR:-/tmp}/workouts-media-upload.XXXXXX") || die "media-upload: mktemp failed"
  local key_file="$MU_TMP/cloudkit-key.pem"
  # The PEM may be stored on one line (spaces where the newlines were) or as normal multi-line text. Keep the BEGIN/END
  # label (EC PRIVATE KEY or PRIVATE KEY), strip whitespace from the body and re-wrap it at 64 columns. The key only ever
  # flows through this pipe into the file.
  if ! op read "$item/private key" 2>/dev/null | awk '
      { s = s " " $0 }
      END {
        if (!match(s, /-----BEGIN [A-Z ]+-----/)) exit 1
        label = substr(s, RSTART + 11, RLENGTH - 16)
        body = substr(s, RSTART + RLENGTH)
        sub(/-----END [A-Z ]+-----.*/, "", body)
        gsub(/[ \t\r\n]/, "", body)
        if (body == "") exit 1
        print "-----BEGIN " label "-----"
        for (i = 1; i <= length(body); i += 64) print substr(body, i, 64)
        print "-----END " label "-----"
      }' >"$key_file"; then
    die "media-upload: could not read the private key from 1Password"
  fi
  chmod 600 "$key_file"
  openssl pkey -in "$key_file" -noout >/dev/null 2>&1 || die "media-upload: the private key from 1Password is not a valid PEM"

  local args=(--key-file "$key_file" --key-id "$key_id" --env "$env" --media-dir "$media_dir" --limit "$limit")
  [[ -z "$only" ]] || args+=(--only "$only")
  ((lookup == 0)) || args+=(--lookup)
  python3 -I scripts/media-upload.py "${args[@]}"
}

cmd_clean() { rm -rf .build; }

cmd_check() {
  cmd_lint || return
  cmd_kit || return
  cmd_duo_test || return
  cmd_build || return
  cmd_test || return
  # The PreToolUse hook that gates `git commit` compares this stamp's mtime against changed files.
  mkdir -p .build && touch .build/check.stamp
  echo "check: ok"
}

# The accessibility tree of a `-preview <Name>` screen (PLAN device-tool C.6): WorkoutsUITests/TreeDumpUITests dumps
# XCUIApplication.debugDescription as a kept attachment (the test's stdout does not reach the quiet log), read back from the
# run's xcresult (latest-tree.xcresult). Reuses run_tests, so the build, the simulator lock and the crash guard are the usual ones.
cmd_tree() {
  local name="${1:-}"
  [[ -n "$name" && "$name" != -* && "$name" != */* ]] || die "usage: tree <PreviewName>"
  command -v jq >/dev/null 2>&1 || die "tree: jq is required"
  # Its own bundle name (latest-tree.xcresult), so the merged bundle of the last full ui-test, which `coverage ui-test` reads, is untouched.
  # The totals line is noise here: the tree is the output. Failures still reach stderr.
  rm -rf "$RESULTS/latest-tree.xcresult"
  TEST_RUNNER_TREE_PREVIEW="$name" run_tests tree WorkoutsUITests 'TreeDumpUITests/testDump()' >/dev/null
  local bundle="$RESULTS/latest-tree.xcresult" out
  [[ -d "$bundle" ]] || die "tree: no result bundle at $bundle"
  out=$(mktemp -d "${TMPDIR:-/tmp}/dev-tree.XXXXXX")
  xcrun xcresulttool export attachments --path "$bundle" --output-path "$out" >/dev/null 2>&1 || true
  local file text
  file=$(jq -r '[.[].attachments[]? | select(.suggestedHumanReadableName | startswith("tree-"))][0].exportedFileName // empty' "$out/manifest.json" 2>/dev/null) || file=""
  [[ -n "$file" && -f "$out/$file" ]] || { rm -rf "$out"; die "tree: the dump attachment is missing from $bundle (TreeDumpUITests did not run, or skipped itself)"; }
  text=$(sed -n '/^=== TREE BEGIN ===$/,/^=== TREE END ===$/p' "$out/$file")
  if [[ -z "$text" ]]; then text=$(<"$out/$file"); fi
  rm -rf "$out"
  [[ -n "$text" ]] || die "tree: the dump for '$name' is empty"
  printf '%s\n' "$text"
}

