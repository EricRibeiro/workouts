#!/usr/bin/env bash
# Single entry point for building, testing, and running Workouts. Quiet on success, focused on failure.
# Every simulator verb runs through simkit's `sim` CLI (see "sim_lease" and the verbs below); the rest is plain bash.
set -euo pipefail

cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BUNDLE_ID="com.ericribeiro.Workouts"
LOGS=".build/logs"
UI_RESULT=".build/simkit/test/WorkoutsUITests/result.json"           # the full ui-test's result, read by the testflight --upload gate
HEALTH_RESULT=".build/simkit/test/WorkoutsUITests-health/result.json" # the real-Health run's result, read by the Health gate
# What the real-Health pass vouches for: a change to any of these since that run's commit needs a new pass before an upload.
HEALTH_PATHS=(Workouts/Features/Health Packages/WorkoutsKit/Sources/WorkoutsKit/Health Workouts/Workouts.entitlements WorkoutsUITests/HealthKitIntegrationUITests.swift)
KIT="Packages/WorkoutsKit"
LINT_PATHS=(Workouts WorkoutsLiveActivity Shared WorkoutsTests WorkoutsUITests Packages)
NOISE='IDERunDestination|IDESchemeActionDeviceRecord|IDETestOperationsObserverDebug'
MAX_LINES=80
SIM="${SIMKIT_HOME:-$HOME/Projects/simkit}/bin/sim"

die() { echo "dev: $*" >&2; exit 1; }

# simkit passes its exit code on unchanged (75 = the queue says wait; never retried here).
sim() {
  [[ -x "$SIM" ]] || die "simkit's sim is not at $SIM (SIMKIT_HOME names the simkit checkout)"
  "$SIM" "$@"
}
# The session lease (the git worktree) for a verb that works on the simulator over several calls; idempotent.
sim_lease() {
  [[ -x "$SIM" ]] || die "simkit's sim is not at $SIM (SIMKIT_HOME names the simkit checkout)"
  "$SIM" lease acquire >/dev/null || exit $?
}

# Print at most MAX_LINES of stdin, noting truncation.
cap() {
  awk -v max="$MAX_LINES" 'NR <= max { print } NR == max + 1 { print "... (truncated)" }'
}

# Run a command, logging combined output to $LOGS/$1.log (noise filtered, or xcbeautify if present).
# Prints nothing on success; on failure prints an error excerpt and returns the command's exit code.
# Logs and result bundles carry the PID so parallel workers running the same command do not clobber each other.
run_logged() {
  local name="$1"; shift
  local log="$LOGS/$name-$$.log" rc errexit=0
  mkdir -p "$LOGS"
  find "$LOGS" -name '*.log' -mmin +240 -delete 2>/dev/null || true
  LAST_LOG="$log"
  # Give errexit back the way we found it: an unconditional `set -e` here would switch it on for a caller that had turned it off.
  [[ $- != *e* ]] || errexit=1
  set +e
  if command -v xcbeautify >/dev/null 2>&1; then
    "$@" 2>&1 | xcbeautify --quiet >"$log"
  else
    "$@" 2>&1 | { grep -Ev "$NOISE" || true; } >"$log"
  fi
  rc=${PIPESTATUS[0]}
  if ((errexit)); then set -e; fi
  if ((rc != 0)); then
    echo "FAILED: $name (exit $rc), full log: $log" >&2
    excerpt "$log" | cap >&2
  fi
  return "$rc"
}

# Pull the interesting lines from a log: errors first, otherwise the tail.
excerpt() {
  local log="$1"
  if grep -qE '(error:|error\b.*:|\*\* .* FAILED|✖|❌|Test .* failed|Issue recorded)' "$log"; then
    grep -E '(error:|\*\* .* FAILED|✖|❌|Test .* failed|Issue recorded)' "$log" | awk '!seen[$0]++'
  else
    tail -n 40 "$log"
  fi
}

# Pure decisions behind the upload gates; they take their inputs as arguments so ./dev selftest runs them on fixtures.
ui_gate_verdict() { # ui_gate_verdict <result.json> <head>: succeeds (printing the flaky tests, or none) for a full run that passed on <head> with a clean tree; else prints why not and returns 1
  local f="$1" head="$2" filter exit_code commit clean short
  [[ -f "$f" ]] || { echo "no result at $f"; return 1; }
  jq -e . "$f" >/dev/null 2>&1 || { echo "unreadable result at $f"; return 1; }
  filter=$(jq -r '.filter // empty' "$f"); exit_code=$(jq -r '.exit_code // empty' "$f")
  commit=$(jq -r '.commit // empty' "$f"); clean=$(jq -r '.clean // empty' "$f")
  [[ -z "$filter" ]] || { echo "the last run was filtered to $filter"; return 1; }
  [[ "$exit_code" == 0 ]] || { echo "the last run failed (exit code ${exit_code:-unknown})"; return 1; }
  short="${commit:0:7}"
  [[ "$commit" == "$head" ]] || { echo "the last run was on commit ${short:-none}"; return 1; }
  [[ "$clean" == true ]] || { echo "the last run had a dirty tree"; return 1; }
  jq -r '(.flaky // []) | if length == 0 then "none" else join(", ") end' "$f"
}
health_gate_verdict() { # health_gate_verdict <result.json> <repo>: succeeds when the Health paths in the working tree (uncommitted and untracked edits included) match the commit of a passing run on a clean tree that skipped nothing; else prints the commit (or none)
  local commit=""
  [[ ! -f "$1" ]] || commit=$(jq -r 'select(.exit_code == 0 and .totals.skipped == 0 and .clean == true) | .commit // empty' "$1" 2>/dev/null) || commit=""
  if [[ -n "$commit" ]] && git -C "$2" diff --quiet "$commit" -- "${HEALTH_PATHS[@]}" 2>/dev/null &&
    [[ -z "$(git -C "$2" ls-files --others --exclude-standard -- "${HEALTH_PATHS[@]}" 2>/dev/null)" ]]; then return 0; fi
  echo "${commit:-none}"
  return 1
}

cmd_kit() {
  [[ -d "$KIT" ]] || die "$KIT does not exist"
  if [[ -n "${1:-}" ]]; then
    run_logged kit bash -c 'cd "$1" && swift test --filter "$2"' _ "$KIT" "$1" || return 1
  else
    run_logged kit bash -c 'cd "$1" && swift test' _ "$KIT" || return 1
  fi
  kit_summary "${1:-}"
}

# Regenerates Resources/Library/thumbs/thumb-crops.json (the figure's crop rectangle per exercise) from the bundled thumbnails.
cmd_thumb_crops() {
  local bin=".build/thumb-crops"
  mkdir -p "$bin"
  run_logged thumb-crops xcrun swiftc -O Tools/thumb-crops.swift -o "$bin/thumb-crops" || return 1
  "$bin/thumb-crops" Resources/Library/thumbs Resources/Library/thumbs/thumb-crops.json
}

# Whole-package line coverage: swift test --enable-code-coverage, then the TOTAL row of llvm-cov's report.
cmd_kit_coverage() {
  [[ -d "$KIT" ]] || die "$KIT does not exist"
  run_logged kit-coverage bash -c 'cd "$1" && swift test --enable-code-coverage' _ "$KIT"
  kit_summary "" || return
  local json prof bin report
  json=$(cd "$KIT" && swift test --show-codecov-path)
  prof="$(dirname "$json")/default.profdata"
  [[ -f "$prof" ]] || die "kit-coverage: no profdata at $prof"
  local products; products=$(dirname "$(dirname "$json")") # .../Products/Debug, next to codecov/
  bin=$(find "$products" -maxdepth 1 -name '*.xctest' | head -n 1)
  [[ -d "$bin" ]] || die "kit-coverage: no .xctest bundle in $products"
  [[ -d "$bin/Contents/MacOS" ]] && bin="$bin/Contents/MacOS/$(basename "$bin" .xctest)"
  report=$(xcrun llvm-cov report "$bin" -instr-profile="$prof" 2>&1) || die "kit-coverage: llvm-cov failed: $report"
  grep '^TOTAL' <<<"$report" | awk '{ printf "kit coverage: lines %s (%d of %d), regions %s, functions %s\n", $10, $8 - $9, $8, $4, $7 }'
}

# swift test exits 0 when --filter matches nothing; turn that into a failure, else print the totals line.
swift_test_summary() { # swift_test_summary <label> <filter>
  local log="$LAST_LOG" line
  if grep -q 'No matching test cases were run' "$log"; then
    echo "FAILED: $1 — no tests matched filter '$2' (check the suite/test name)" >&2
    return 1
  fi
  # swift test can exit 0 with a failing Swift Testing run when XCTest also ran, so the totals line is the verdict: a
  # "failed" line fails, a "passed" line passes, and no line at all is a failure, never "ok" (2026-11-09: check said
  # "kit: ok" over a failed run).
  line=$(grep -E 'Test run with .* failed' "$log" | tail -n 1 || true)
  if [[ -n "$line" ]]; then
    echo "FAILED: $1: Test run with ${line#*Test run with } (full log: $log)" >&2
    return 1
  fi
  line=$(grep -E 'Test run with .* passed' "$log" | tail -n 1 || true)
  if [[ -n "$line" ]]; then
    echo "$1: Test run with ${line#*Test run with }"
  else
    echo "FAILED: $1: no test totals line in $log" >&2
    return 1
  fi
}
kit_summary() { swift_test_summary kit "$1"; } # kit_summary <filter>
cmd_kit_build() {
  [[ -d "$KIT" ]] || die "$KIT does not exist"
  run_logged kit-build bash -c 'cd "$1" && swift build' _ "$KIT"
}

swift_format() { # swift_format <lint --strict|format --in-place>
  xcrun swift-format "$@" --recursive --parallel "${LINT_PATHS[@]}"
}
cmd_lint() {
  local out rc=0
  out=$(swift_format lint --strict 2>&1) || rc=$?
  if ((rc != 0)); then
    echo "$out" | cap >&2
    echo "FAILED: lint (exit $rc). Fix with: ./dev format" >&2
  fi
  return "$rc"
}
cmd_format() { swift_format format --in-place; }

# Simulator verbs: each one a call to simkit's `sim`. Whole jobs (test, ui-test, tree, shot, poses) take no lease from here:
# simkit uses the session's when one is held, else a lease of its own for the job.
cmd_build() { sim app build; } # takes no lease and boots nothing: it builds for a pool simulator's id
cmd_run() { # cmd_run [-- app launch args...]; args reach the app, e.g. ./dev run -- -preview Swatches
  [[ "${1:-}" == "--" ]] && shift
  sim_lease
  if (($# > 0)); then sim app run -- "$@"; else sim app run; fi
}
cmd_release() { sim lease release; }
cmd_sims() { sim status; }

is_health_filter() { [[ "${1:-}" == HealthKitIntegration* ]]; }
cmd_test() {
  # Snapshot tests record their references when the runner sees SNAPSHOT_RECORD; simkit maps only TEST_RUNNER_-prefixed variables.
  [[ -z "${SNAPSHOT_RECORD:-}" ]] || export TEST_RUNNER_SNAPSHOT_RECORD="$SNAPSHOT_RECORD"
  sim test WorkoutsTests ${1:+"$1"}
}
cmd_ui_test() {
  local extra=()
  [[ -z "${DEV_POSE:-}" ]] || extra+=(--pose "$DEV_POSE")
  # The real-Health run keeps its result apart (its simulator, environment and skips come from simkit.json "suites").
  ! is_health_filter "${1:-}" || extra+=(--out .build/simkit/test/WorkoutsUITests-health)
  sim test WorkoutsUITests ${1:+"$1"} ${extra[@]+"${extra[@]}"}
}
cmd_ui_status() { sim test status; }
cmd_ui_flaky() {
  [[ $# -eq 0 || ( "$1" == --since && "${2:-}" =~ ^[0-9]+$ && $# -eq 2 ) ]] || die "usage: ./dev ui-flaky [--since <days>]"
  sim test flaky WorkoutsUITests "$@"
}
cmd_coverage() {
  local target
  case "${1:-test}" in
    test) target=WorkoutsTests ;;
    ui-test) target=WorkoutsUITests ;;
    *) die "coverage: unknown kind '$1' (usage: coverage [test|ui-test])" ;;
  esac
  sim test coverage ".build/simkit/test/$target"
}
# The accessibility tree of a `-preview <Name>` screen: TreeDumpUITests attaches XCUIApplication.debugDescription, which
# `sim test --attachments` exports; the tree is that attachment's text.
cmd_tree() {
  local name="${1:-}" out file text rc=0
  [[ -n "$name" && "$name" != -* && "$name" != */* ]] || die "usage: tree <PreviewName>"
  command -v jq >/dev/null 2>&1 || die "tree: jq is required"
  out=$(mktemp -d "${TMPDIR:-/tmp}/dev-tree.XXXXXX")
  TEST_RUNNER_TREE_PREVIEW="$name" sim test WorkoutsUITests 'TreeDumpUITests/testDump()' --out .build/simkit/test/tree --attachments "$out" >/dev/null || rc=$?
  if ((rc != 0)); then rm -rf "${out:?}"; return "$rc"; fi
  file=$(jq -r '[.[].attachments[]? | select(.suggestedHumanReadableName | startswith("tree-"))][0].exportedFileName // empty' "$out/manifest.json" 2>/dev/null) || file=""
  [[ -n "$file" && -f "$out/$file" ]] || { rm -rf "${out:?}"; die "tree: the dump attachment is missing from the run (TreeDumpUITests did not run, or skipped itself)"; }
  text=$(sed -n '/^=== TREE BEGIN ===$/,/^=== TREE END ===$/p' "$out/$file")
  if [[ -z "$text" ]]; then text=$(<"$out/$file"); fi
  rm -rf "${out:?}"
  [[ -n "$text" ]] || die "tree: the dump for '$name' is empty"
  printf '%s\n' "$text"
}

cmd_ui_env() { sim_lease; sim app ui "$@"; }
cmd_screenshot() {
  local path="${1:-.build/screenshots/$(date +%Y%m%d-%H%M%S).png}" extra=()
  [[ -z "${DEV_DISPLAY:-}" ]] || extra=(--display "$DEV_DISPLAY")
  mkdir -p "$(dirname "$path")"
  sim_lease
  sim screenshot "$path" ${extra[@]+"${extra[@]}"}
}
cmd_shot() { # cmd_shot [--burst [<count>x<intervalMs>]] <png> [-- app launch args...]
  local burst=()
  if [[ "${1:-}" == --burst ]]; then
    shift
    if [[ "${1:-}" =~ ^[0-9]+x[0-9]+$ ]]; then burst=(--burst "$1"); shift; else burst=(--burst 15x100); fi
  fi
  local path="${1:-}"
  [[ -n "$path" && "$path" != -* ]] || die "usage: shot [--burst [<count>x<intervalMs>]] <png> [-- app args...]"
  shift
  [[ "${1:-}" == "--" ]] && shift
  if (($# > 0)); then sim shot "$path" ${burst[@]+"${burst[@]}"} -- "$@"; else sim shot "$path" ${burst[@]+"${burst[@]}"}; fi
}
cmd_poses() { # cmd_poses <dir> [-- app launch args...]
  local dir="${1:-}"
  [[ -n "$dir" && "$dir" != -* ]] || die "usage: poses <dir> [-- app args...]"
  shift
  [[ "${1:-}" == "--" ]] && shift
  if (($# > 0)); then sim poses "$dir" -- "$@"; else sim poses "$dir"; fi
}
png_ok() { [[ -z "${1:-}" || "$1" != -* ]]; } # an optional png path must not look like an option
cmd_home() {
  png_ok "${1:-}" || die "usage: home [screenshot.png]"
  sim_lease
  if [[ -n "${1:-}" ]]; then sim home --png "$1"; else sim home; fi
}
cmd_fold() {
  if [[ "${1:-}" == --keyframes ]]; then # timed hinge motion: [{"atMs":0,"angle":0},{"atMs":3000,"angle":180}], optionally recorded
    [[ -n "${2:-}" && "$2" != -* ]] || die "usage: fold --keyframes '<json>' [--record <movie.mov> [--display lit|outer|inner]]"
    sim_lease
    sim fold "$@"
    return
  fi
  [[ "${1:-}" =~ ^(closed|half-open|open)$ ]] && png_ok "${2:-}" || die "usage: fold closed|half-open|open [screenshot.png]"
  sim_lease
  if [[ -n "${2:-}" ]]; then sim fold "$1" --png "$2"; else sim fold "$1"; fi
}
cmd_orient() {
  [[ "${1:-}" =~ ^(portrait|landscape-left|landscape-right)$ ]] && png_ok "${2:-}" || die "usage: orient portrait|landscape-left|landscape-right [screenshot.png]"
  sim_lease
  if [[ -n "${2:-}" ]]; then sim orient "$1" --png "$2"; else sim orient "$1"; fi
}
cmd_pose() { # fold + orient + verify in one call; the names are the layouts verify-ui checks
  [[ "${1:-}" =~ ^(closed-portrait|closed-landscape|open-wide|open-tall)$ ]] && png_ok "${2:-}" \
    || die "usage: pose closed-portrait|closed-landscape|open-wide|open-tall [screenshot.png]"
  sim_lease
  sim pose "$1" ${2:+"$2"}
}
cmd_duo() { # pass-through to simkit's verbs of the same name, on this session's lease
  local verb="${1:-}" a app=0 sub=0
  case "$verb" in
    panels | screenshot | settle | hinge | fold | orient | pose | home) ;;
    *) die "usage: duo panels|screenshot|settle|hinge|fold|orient|pose|home [args] (simkit's verbs, on this session's lease)" ;;
  esac
  local args=("$@")
  for a in "$@"; do
    case "$a" in --app) app=1 ;; --subsystem | --subsystem=*) sub=1 ;; esac
  done
  if [[ "$verb" == hinge ]] && ((app == 1 && sub == 0)); then args+=(--subsystem "$BUNDLE_ID"); fi
  sim_lease
  sim "${args[@]}"
}
cmd_probe() { # cmd_probe [dir]: launch the app for the UI tests' in-memory store, then answer sim/probes.json into <dir>
  local dir="${1:-.build/probe}"
  sim_lease
  sim app run -- -uiTesting
  sim probe sim/probes.json "$dir"
}


# Signed App Store Connect export (TestFlight). Needs the App Store Connect API key in 1Password (read with `op`, which
# works headless through the service account). The key is streamed from `op read` straight into a 0600 file in a private
# temp directory under $TMPDIR: never into a shell variable, an environment variable, a command-line argument or a log.
# Only the file PATH reaches xcodebuild. A trap deletes the directory on EXIT, INT, TERM and HUP. Does not use the
# simulator.
TF_DIR=".build/testflight"
TF_TEAM="S8Y5FT7937"
TF_TMP=""
# `testflight --upload` ships only a commit whose full ./dev ui-test passed (simkit's result.json, read by ui_gate_verdict).
tf_ui_gate() { # tf_ui_gate [result.json] [head]
  if [[ "${DEV_SKIP_UI_GATE:-}" == 1 ]]; then
    echo "dev: WARNING: DEV_SKIP_UI_GATE=1, uploading without a passing ./dev ui-test on this commit" >&2
    return 0
  fi
  local head why
  head="${2:-$(git rev-parse HEAD)}"
  why=$(ui_gate_verdict "${1:-$UI_RESULT}" "$head") ||
    die "testflight: refusing to upload: run ./dev ui-test on this commit first (full suite, clean tree; $why, HEAD: $head). DEV_SKIP_UI_GATE=1 overrides."
  echo "dev: testflight: the full ui-test's flaky tests: $why" >&2
}
# Independent of the ui-test gate and its DEV_SKIP_UI_GATE: the full run skips the real-Health test, so it never vouches for the reader.
tf_health_gate() { # tf_health_gate [result.json] [repo]
  if [[ "${DEV_SKIP_HEALTH_GATE:-}" == 1 ]]; then
    echo "dev: WARNING: DEV_SKIP_HEALTH_GATE=1, uploading without a real-Health-store pass on the current Health reader" >&2
    return 0
  fi
  local since
  since=$(health_gate_verdict "${1:-$HEALTH_RESULT}" "${2:-.}") && return 0
  die "testflight: the Health code (reader, kit mapping, entitlements or test) changed since the last real-store pass ($since; uncommitted edits count): ./dev ui-test HealthKitIntegrationUITests first; DEV_SKIP_HEALTH_GATE=1 overrides"
}
tf_cleanup() { [[ -z "$TF_TMP" ]] || rm -rf "$TF_TMP"; TF_TMP=""; }

cmd_testflight() {
  { set +x; } 2>/dev/null # never trace this function: a traced command line could carry key material
  local upload=0
  case "${1:-}" in
    "") ;;
    --upload) upload=1 ;;
    *) die "testflight: unknown argument '$1' (usage: testflight [--upload])" ;;
  esac
  # The gate runs before anything touches 1Password or the archive.
  if ((upload == 1)); then tf_ui_gate; tf_health_gate; fi
  command -v op >/dev/null 2>&1 || die "testflight: the 1Password CLI (op) is not installed"

  local key_id issuer_id build
  key_id=$(op read "op://Homelab/Apple App Store Connect API/key id" 2>/dev/null) || die "testflight: could not read the key id from 1Password"
  issuer_id=$(op read "op://Homelab/Apple App Store Connect API/issuer id" 2>/dev/null) || die "testflight: could not read the issuer id from 1Password"
  [[ -n "$key_id" && -n "$issuer_id" ]] || die "testflight: an App Store Connect API id is empty"

  trap tf_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  umask 077
  TF_TMP=$(mktemp -d "${TMPDIR:-/tmp}/workouts-testflight.XXXXXX") || die "testflight: mktemp failed"
  local key_file="$TF_TMP/AuthKey_${key_id}.p8"
  # The vault stores the PEM on one line, spaces where the newlines were. Keep the BEGIN/END markers, strip every space
  # from the body and re-wrap it at 64 columns. The key only ever flows through this pipe into the file.
  if ! op read "op://Homelab/Apple App Store Connect API/auth key" 2>/dev/null | awk '
      { s = s $0 }
      END {
        gsub(/-----BEGIN PRIVATE KEY-----/, "", s); gsub(/-----END PRIVATE KEY-----/, "", s); gsub(/[ \t\r]/, "", s)
        if (s == "") exit 1
        print "-----BEGIN PRIVATE KEY-----"
        for (i = 1; i <= length(s); i += 64) print substr(s, i, 64)
        print "-----END PRIVATE KEY-----"
      }' >"$key_file"; then
    die "testflight: could not read the auth key from 1Password"
  fi
  chmod 600 "$key_file"
  openssl pkey -in "$key_file" -noout >/dev/null 2>&1 || die "testflight: the auth key from 1Password is not a valid PEM"

  build=$(date -u +%Y%m%d%H%M)
  local archive="$TF_DIR/Workouts.xcarchive" plist="$TF_DIR/ExportOptions.plist" export_dir="$TF_DIR/export"
  local auth=(-allowProvisioningUpdates -authenticationKeyPath "$key_file" -authenticationKeyID "$key_id"
    -authenticationKeyIssuerID "$issuer_id")
  rm -rf "$archive" "$export_dir"
  mkdir -p "$TF_DIR"

  # Archive with development signing from the Xcode account on this Mac (Apple ID in Xcode > Settings > Accounts, the
  # registered Duo, keychain access approved once): that keeps the entitlements (iCloud, time-sensitive), which an unsigned
  # archive loses. The API key is not accepted for development provisioning ("Authentication failed"), so it is used only
  # by the export/upload below, which re-signs for App Store distribution with cloud-managed certificates (JC48, JC55).
  run_logged testflight-archive xcodebuild archive -scheme "$SCHEME" -destination 'generic/platform=iOS' \
    -archivePath "$archive" -derivedDataPath "$TF_DIR/DerivedData" -quiet -allowProvisioningUpdates CURRENT_PROJECT_VERSION="$build" \
    || return

  local destination=export
  ((upload == 0)) || destination=upload
  cat >"$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>$TF_TEAM</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>destination</key>
	<string>$destination</string>
</dict>
</plist>
PLIST

  run_logged testflight-export xcodebuild -exportArchive -archivePath "$archive" -exportOptionsPlist "$plist" \
    -exportPath "$export_dir" "${auth[@]}" || return

  if ((upload == 1)); then
    echo "testflight: uploaded build $build"
  else
    local ipa; ipa=$(find "$export_dir" -maxdepth 1 -name '*.ipa' | head -n 1)
    [[ -n "$ipa" ]] || die "testflight: export produced no .ipa in $export_dir"
    echo "testflight: build $build $ipa"
  fi
}

# Uploads exercise videos to CloudKit's public database (Web Services, server-to-server key; docs/port/media.md). The key
# handling mirrors cmd_testflight: streamed from `op read` into a 0600 file in a private temp directory a trap deletes,
# never into a variable, environment variable, argument or log. Only the key FILE path reaches the Python script, which
# signs by running `openssl dgst -sha256 -sign <file>`. Does not use the simulator.
MU_TMP=""
mu_cleanup() { [[ -z "$MU_TMP" ]] || rm -rf "$MU_TMP"; MU_TMP=""; }

cmd_media_upload() {
  { set +x; } 2>/dev/null # never trace this function: a traced command line could carry key material
  local env=development limit=0 only="" lookup=0
  local usage="usage: media-upload [--env development|production] [--limit N] [--only <sourceId>] [--lookup]"
  while (($#)); do
    case "$1" in
      --lookup) lookup=1; shift ;; # read-only: print each stored asset's size and download host (with --only or --limit)
      --env) [[ "${2:-}" =~ ^(development|production)$ ]] || die "media-upload: $usage"; env="$2"; shift 2 ;;
      --limit) [[ "${2:-}" =~ ^[0-9]+$ ]] || die "media-upload: $usage"; limit="$2"; shift 2 ;;
      --only) [[ -n "${2:-}" && "$2" != -* && "$2" != */* ]] || die "media-upload: $usage"; only="$2"; shift 2 ;;
      *) die "media-upload: unknown argument '$1' ($usage)" ;;
    esac
  done
  local media_dir="${MEDIA_DIR:-$HOME/Server/docker-volumes/workouts/snapshot/media}"
  [[ -d "$media_dir" ]] || die "media-upload: $media_dir does not exist"
  command -v op >/dev/null 2>&1 || die "media-upload: the 1Password CLI (op) is not installed"

  local key_id
  # Server-to-server keys are per environment: the 1Password item has a development and a production section.
  local item="op://Homelab/Apple Cloud Kit for Workouts Duo/$env"
  key_id=$(op read "$item/key id" 2>/dev/null) || die "media-upload: could not read the key id from 1Password"
  [[ -n "$key_id" ]] || die "media-upload: the CloudKit key id is empty"

  trap mu_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  umask 077
  MU_TMP=$(mktemp -d "${TMPDIR:-/tmp}/workouts-media-upload.XXXXXX") || die "media-upload: mktemp failed"
  local key_file="$MU_TMP/cloudkit-key.pem"
  # The PEM may be stored on one line (spaces where the newlines were) or as normal multi-line text. Keep the BEGIN/END
  # label (EC PRIVATE KEY or PRIVATE KEY), strip whitespace from the body and re-wrap it at 64 columns. The key only ever
  # flows through this pipe into the file.
  if ! op read "$item/private key" 2>/dev/null | awk '
      { s = s " " $0 }
      END {
        if (!match(s, /-----BEGIN [A-Z ]+-----/)) exit 1
        label = substr(s, RSTART + 11, RLENGTH - 16)
        body = substr(s, RSTART + RLENGTH)
        sub(/-----END [A-Z ]+-----.*/, "", body)
        gsub(/[ \t\r\n]/, "", body)
        if (body == "") exit 1
        print "-----BEGIN " label "-----"
        for (i = 1; i <= length(body); i += 64) print substr(body, i, 64)
        print "-----END " label "-----"
      }' >"$key_file"; then
    die "media-upload: could not read the private key from 1Password"
  fi
  chmod 600 "$key_file"
  openssl pkey -in "$key_file" -noout >/dev/null 2>&1 || die "media-upload: the private key from 1Password is not a valid PEM"

  local args=(--key-file "$key_file" --key-id "$key_id" --env "$env" --media-dir "$media_dir" --limit "$limit")
  [[ -z "$only" ]] || args+=(--only "$only")
  ((lookup == 0)) || args+=(--lookup)
  python3 -I scripts/media-upload.py "${args[@]}"
}

# Exports, validates and deploys the CloudKit schema with `xcrun cktool`. The management token lives only in 1Password:
# `op run` resolves the op:// reference in the environment it hands cktool, so the token never reaches a variable,
# argument, file or log here. Does not use the simulator.
CK_TOKEN_REF="op://Homelab/Apple Cloud Kit for Workouts Duo/management token"
ck_tool() { CLOUDKIT_MANAGEMENT_TOKEN="$CK_TOKEN_REF" op run -- xcrun cktool "$@"; }

# Field lines of a `.ckdb` export as `<record type> <field> <field type>`, in file order. A field line is `name TYPE [modifiers],`
# (name optionally quoted, as for "___etag"); GRANT lines and the closing `);` are not fields. Pure: no token, no network.
ck_fields() { # ck_fields <ckdb file>
  awk '
    /^[[:space:]]*RECORD TYPE / { t = $3; sub(/\(.*/, "", t); next }
    t != "" && /^[[:space:]]*\)/ { t = ""; next }
    t != "" && NF >= 2 {
      f = $1; ty = $2; gsub(/"/, "", f); sub(/,$/, "", ty)
      if (f != "GRANT" && ty ~ /^[A-Z0-9_<>]+$/) print t, f, ty
    }' "$1"
}
# Field-level difference between a Development and a Production export, for the record types both have (a type Production
# lacks entirely is reported by the caller). Prints one line per difference; fails when there is any.
ck_fields_diff() { # ck_fields_diff <development ckdb> <production ckdb>
  { ck_fields "$1" | sed 's/^/D /'; ck_fields "$2" | sed 's/^/P /'; } | awk '
    $1 == "D" { dev[$2 "." $3] = $4; dt[$2] = 1; order[++n] = $2 "." $3; next }
    { prod[$2 "." $3] = $4; pt[$2] = 1; porder[++m] = $2 "." $3 }
    END {
      for (i = 1; i <= n; i++) {
        k = order[i]; split(k, parts, "."); if (!(parts[1] in pt)) continue
        if (!(k in prod)) { print "ck-schema: production lacks field " k " (" dev[k] ")"; bad = 1 }
        else if (dev[k] != prod[k]) { print "ck-schema: field " k " is " dev[k] " in development but " prod[k] " in production"; bad = 1 }
      }
      for (i = 1; i <= m; i++) {
        k = porder[i]; split(k, parts, "."); if (!(parts[1] in dt)) continue
        if (!(k in dev)) { print "ck-schema: production has field " k " (" prod[k] ") that development lacks"; bad = 1 }
      }
      exit bad
    }'
}

cmd_ck_schema() {
  { set +x; } 2>/dev/null # never trace this function: a traced command line could carry the token reference's value
  local usage="usage: ck-schema export [--env development|production] | diff | fields <ckdb file>"
  local container=iCloud.com.ericribeiro.Workouts verb="${1:-}" env=development
  [[ $# -gt 0 ]] && shift
  case "$verb" in
    export)
      while (($#)); do
        case "$1" in
          --env) [[ "${2:-}" =~ ^(development|production)$ ]] || die "ck-schema: $usage"; env="$2"; shift 2 ;;
          *) die "ck-schema: unknown argument '$1' ($usage)" ;;
        esac
      done ;;
    diff) (($# == 0)) || die "ck-schema: unknown argument '$1' ($usage)" ;;
    fields) # offline: needs neither op nor cktool
      (($# == 1)) && [[ -f "$1" ]] || die "ck-schema: $usage"
      ck_fields "$1"; return ;;
    *) die "ck-schema: ${verb:+unknown command '$verb' }($usage)" ;;
  esac
  command -v op >/dev/null 2>&1 || die "ck-schema: the 1Password CLI (op) is not installed"
  xcrun cktool version >/dev/null 2>&1 || die "ck-schema: xcrun cktool is not available"

  local team
  team=$(grep -m1 -oE '"DEVELOPMENT_TEAM": *"[A-Z0-9]+"' Workouts.xcodeproj/project.xcproj | grep -oE '[A-Z0-9]+"$' | tr -d '"')
  [[ -n "$team" ]] || die "ck-schema: no DEVELOPMENT_TEAM found in Workouts.xcodeproj/project.xcproj"
  # Resolve the reference once with a no-op child so a missing 1Password field is reported apart from a cktool failure.
  CLOUDKIT_MANAGEMENT_TOKEN="$CK_TOKEN_REF" op run -- true ||
    die "ck-schema: could not resolve the management token ($CK_TOKEN_REF)"

  mkdir -p .build/cloudkit
  ck_export() { # <environment>: writes .build/cloudkit/schema-<env>.ckdb and prints its record types
    local file=".build/cloudkit/schema-$1.ckdb" types
    ck_tool export-schema --team-id "$team" --container-id "$container" --environment "$1" --output-file "$file" || return
    types=$(grep -oE 'RECORD TYPE [A-Za-z0-9_]+' "$file" | awk '{print $3}' || true)
    echo "ck-schema: $1 schema written to $file"
    echo "ck-schema: $1 has $(echo "$types" | grep -c .) record types: $(echo "$types" | paste -sd' ' -)"
  }

  case "$verb" in
    export) ck_export "$env" ;;
    diff)
      # Promotion itself is Console-only: cktool's import-schema and validate-schema answer "endpoint not applicable in
      # the environment 'production'" (2026-11-08). This shows what the Console's "Deploy Schema Changes…" still has to add.
      ck_export development || return
      ck_export production || return
      local missing rc=0
      missing=$(comm -23 <(grep -oE 'RECORD TYPE [A-Za-z0-9_]+' .build/cloudkit/schema-development.ckdb | sort) \
        <(grep -oE 'RECORD TYPE [A-Za-z0-9_]+' .build/cloudkit/schema-production.ckdb | sort) | awk '{print $3}' | paste -sd' ' -)
      if [[ -n "$missing" ]]; then
        echo "ck-schema: production is missing: $missing (deploy from the CloudKit Console: Schema → Deploy Schema Changes…)"
        rc=1
      else
        echo "ck-schema: production has every development record type"
      fi
      if ck_fields_diff .build/cloudkit/schema-development.ckdb .build/cloudkit/schema-production.ckdb; then
        echo "ck-schema: production has the same fields and field types as development in every shared record type"
      else
        rc=1
      fi
      return "$rc" ;;
  esac
}

cmd_clean() { rm -rf .build; }

# The parsing and decisions behind the gates and keep list, run on fixture files in a temp directory: no simulator,
# no xcodebuild, nothing under .build is read or written. Not part of `check`.
ST_DIR=""
ST_PASS=0
ST_FAIL=0
ST_OUT=""
ST_RC=0
st_run() { ST_RC=0; ST_OUT=$( ("$@") 2>&1 ) || ST_RC=$?; } # st_run <cmd...>: output and status of a command in a subshell
st_ok() { # st_ok <label> <condition status 0|1>
  if [[ "$2" == 0 ]]; then ST_PASS=$((ST_PASS + 1)); else ST_FAIL=$((ST_FAIL + 1)); echo "FAILED: selftest: $1" >&2; fi
}
st_eq() { # st_eq <label> <expected> <actual>
  if [[ "$2" == "$3" ]]; then ST_PASS=$((ST_PASS + 1)); else ST_FAIL=$((ST_FAIL + 1)); echo "FAILED: selftest: $1 (expected '$2', got '$3')" >&2; fi
}
st_rc() { st_eq "$1 (exit status)" "$2" "$ST_RC"; }                    # st_rc <label> <expected status>: of the last st_run
st_out_has() { local r=0; [[ "$ST_OUT" == *"$2"* ]] || r=1; st_ok "$1 (output has '$2': $ST_OUT)" "$r"; }
st_out_lacks() { local r=0; [[ "$ST_OUT" != *"$2"* ]] || r=1; st_ok "$1 (output lacks '$2': $ST_OUT)" "$r"; }
st_git() { GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -C "$ST_DIR/repo" -c user.name=selftest -c user.email=selftest@example.com "$@"; }
st_commit() { st_git add -A && st_git commit -q -m "$1"; } # st_commit <message>
# st_result <file> <filter|null> <exit_code> <commit|null> <clean true|false|null> <skipped> <flaky json list>: a result.json fixture
st_result() {
  jq -n --argjson filter "$(jq -n --arg v "$2" 'if $v == "null" then null else $v end')" --argjson exit_code "$3" \
    --argjson commit "$(jq -n --arg v "$4" 'if $v == "null" then null else $v end')" --argjson clean "$5" --argjson skipped "$6" --argjson flaky "$7" \
    '{version: 1, filter: $filter, commit: $commit, clean: $clean, exit_code: $exit_code, totals: {total: 4, passed: 4, failed: 0, skipped: $skipped, expected_failures: 0}, flaky: $flaky}' >"$1"
}

cmd_selftest() {
  command -v jq >/dev/null 2>&1 || die "selftest: jq is required"
  set +e
  ST_DIR=$(mktemp -d "${TMPDIR:-/tmp}/dev-selftest.XXXXXX") || die "selftest: mktemp failed"
  trap 'rm -rf "${ST_DIR:?}"' EXIT
  local p

  # swift test totals: a failed run is a failure even when swift test exited 0; no totals line is never "ok".
  p="$ST_DIR/kit.log"
  printf '%s\n' "✔ Test run with 4 tests in 1 suite passed after 0.1 seconds." >"$p"
  LAST_LOG="$p" st_run swift_test_summary kit ""; st_rc "swift_test_summary passed" 0; st_out_has "swift_test_summary passed line" "kit: Test run with 4 tests"
  printf '%s\n' "✘ Test run with 983 tests in 84 suites failed after 45.7 seconds with 1 issue." >"$p"
  LAST_LOG="$p" st_run swift_test_summary kit ""; st_rc "swift_test_summary failed" 1; st_out_has "swift_test_summary failed line" "FAILED: kit: Test run with 983 tests"
  printf '%s\n' "Building for debugging..." >"$p"
  LAST_LOG="$p" st_run swift_test_summary kit ""; st_rc "swift_test_summary without a totals line" 1; st_out_has "swift_test_summary without a totals line" "no test totals line"
  printf '%s\n' "No matching test cases were run" >"$p"
  LAST_LOG="$p" st_run swift_test_summary kit Nope; st_rc "swift_test_summary with an empty filter match" 1

  # Health gate: a fake repo whose Health files change, and the result.json pointing at earlier and later commits.
  local kit_health=Packages/WorkoutsKit/Sources/WorkoutsKit/Health
  mkdir -p "$ST_DIR/repo/Workouts/Features/Health" "$ST_DIR/repo/$kit_health" "$ST_DIR/repo/WorkoutsUITests" "$ST_DIR/repo/Other"
  st_git init -q
  : >"$ST_DIR/repo/Workouts/Features/Health/HealthKitSource.swift"
  : >"$ST_DIR/repo/Workouts/Features/Health/HealthSeeder.swift"
  : >"$ST_DIR/repo/$kit_health/HealthEnrichment.swift"
  : >"$ST_DIR/repo/Workouts/Workouts.entitlements"
  : >"$ST_DIR/repo/WorkoutsUITests/HealthKitIntegrationUITests.swift"
  : >"$ST_DIR/repo/Other/a.swift"
  st_commit one
  local c1 c2 c3 gate_result="$ST_DIR/gate-result.json"
  c1=$(st_git rev-parse HEAD)
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate without a result" 1; st_eq "gate without a result names none" none "$ST_OUT"
  st_result "$gate_result" null 0 "$c1" true 0 '[]'
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate at the result's commit" 0
  echo x >"$ST_DIR/repo/Other/a.swift"; st_commit two; c2=$(st_git rev-parse HEAD)
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate after an unrelated change" 0
  for p in Workouts/Features/Health/HealthKitSource.swift Workouts/Features/Health/HealthSeeder.swift "$kit_health/HealthEnrichment.swift" Workouts/Workouts.entitlements WorkoutsUITests/HealthKitIntegrationUITests.swift; do
    echo x >>"$ST_DIR/repo/$p"; st_commit "touch $p"
    st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate after a change to $p" 1; st_eq "gate names the result's commit for $p" "$c1" "$ST_OUT"
    st_git reset -q --hard "$c2"
  done
  # Uncommitted work counts: a modified tracked file, and a new untracked file under a Health directory.
  st_result "$gate_result" null 0 "$c2" true 0 '[]'
  echo x >>"$ST_DIR/repo/Workouts/Features/Health/HealthSeeder.swift"
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate with an uncommitted edit to a Health file" 1; st_eq "gate names the result's commit for an uncommitted edit" "$c2" "$ST_OUT"
  st_git checkout -q -- Workouts/Features/Health/HealthSeeder.swift
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate after the uncommitted edit is reverted" 0
  : >"$ST_DIR/repo/$kit_health/NewFile.swift"
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate with an untracked file under the kit Health directory" 1
  rm -f "$ST_DIR/repo/$kit_health/NewFile.swift"
  echo x >>"$ST_DIR/repo/Other/a.swift"
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate with an uncommitted unrelated edit" 0
  st_git checkout -q -- Other/a.swift
  echo x >>"$ST_DIR/repo/WorkoutsUITests/HealthKitIntegrationUITests.swift"; st_commit three; c3=$(st_git rev-parse HEAD)
  st_result "$gate_result" null 0 "$c3" true 0 '[]'
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate with a result on the newest commit" 0
  st_result "$gate_result" null 0 0000000000000000000000000000000000000000 true 0 '[]'
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate with a result on an unknown commit" 1
  # tf_health_gate on top of it: the die message, and the override.
  rm -f "$gate_result"
  st_run tf_health_gate "$gate_result" "$ST_DIR/repo"; st_rc "tf_health_gate without a result" 1
  st_out_has "tf_health_gate message" "changed since the last real-store pass (none; uncommitted edits count): ./dev ui-test HealthKitIntegrationUITests first; DEV_SKIP_HEALTH_GATE=1 overrides"
  DEV_SKIP_HEALTH_GATE=1 st_run tf_health_gate "$gate_result" "$ST_DIR/repo"; st_rc "tf_health_gate with the override" 0
  st_out_has "tf_health_gate override" "WARNING: DEV_SKIP_HEALTH_GATE=1"
  st_result "$gate_result" null 0 "$c3" true 0 '[]'
  st_run tf_health_gate "$gate_result" "$ST_DIR/repo"; st_rc "tf_health_gate with a current result" 0; st_eq "tf_health_gate prints nothing when it passes" "" "$ST_OUT"
  DEV_SKIP_UI_GATE=1 st_run tf_health_gate "$gate_result" "$ST_DIR/repo"; st_rc "tf_health_gate ignores DEV_SKIP_UI_GATE" 0
  rm -f "$gate_result"
  DEV_SKIP_UI_GATE=1 st_run tf_health_gate "$gate_result" "$ST_DIR/repo"; st_rc "tf_health_gate is not skipped by DEV_SKIP_UI_GATE" 1

  # The run must have passed on a clean tree and skipped nothing to vouch for a commit.
  st_result "$gate_result" null 1 "$c3" true 0 '[]'
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate with a failed run" 1; st_eq "gate with a failed run names none" none "$ST_OUT"
  st_result "$gate_result" null 0 "$c3" true 3 '[]'
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate with a run that skipped tests" 1; st_eq "gate with a run that skipped tests names none" none "$ST_OUT"
  st_result "$gate_result" null 0 "$c3" false 0 '[]'
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate with a run on a dirty tree" 1; st_eq "gate with a run on a dirty tree names none" none "$ST_OUT"
  st_result "$gate_result" null 0 "$c3" null 0 '[]'
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate with a run whose tree state is unknown" 1; st_eq "gate with a run whose tree state is unknown names none" none "$ST_OUT"
  printf 'not json' >"$gate_result"
  st_run health_gate_verdict "$gate_result" "$ST_DIR/repo"; st_rc "gate with an unreadable result" 1; st_eq "gate with an unreadable result names none" none "$ST_OUT"

  # ui_gate_verdict: the full run's result.json against HEAD.
  local ui="$ST_DIR/ui-result.json" head=1111111111111111111111111111111111111111
  st_result "$ui" null 0 "$head" true 0 '[]'
  st_run ui_gate_verdict "$ui" "$head"; st_rc "ui gate passes" 0; st_eq "ui gate prints none for no flaky tests" none "$ST_OUT"
  st_result "$ui" null 0 "$head" true 0 '["HistoryUITests/a()","SetLoggingUITests/b()"]'
  st_run ui_gate_verdict "$ui" "$head"; st_rc "ui gate passes with flaky tests" 0; st_eq "ui gate lists the flaky tests" "HistoryUITests/a(), SetLoggingUITests/b()" "$ST_OUT"
  st_run ui_gate_verdict "$ST_DIR/none.json" "$head"; st_rc "ui gate without a result" 1; st_out_has "ui gate without a result" "no result at"
  st_result "$ui" HistoryUITests 0 "$head" true 0 '[]'
  st_run ui_gate_verdict "$ui" "$head"; st_rc "ui gate with a filtered run" 1; st_out_has "ui gate with a filtered run" "filtered to HistoryUITests"
  st_result "$ui" null 1 "$head" true 0 '[]'
  st_run ui_gate_verdict "$ui" "$head"; st_rc "ui gate with a failed run" 1; st_out_has "ui gate with a failed run" "failed"
  st_result "$ui" null 0 2222222222222222222222222222222222222222 true 0 '[]'
  st_run ui_gate_verdict "$ui" "$head"; st_rc "ui gate with another commit" 1; st_out_has "ui gate with another commit" "commit 2222222"
  st_result "$ui" null 0 "$head" false 0 '[]'
  st_run ui_gate_verdict "$ui" "$head"; st_rc "ui gate with a dirty tree" 1; st_out_has "ui gate with a dirty tree" "dirty tree"
  st_result "$ui" null 0 "$head" null 0 '[]'
  st_run ui_gate_verdict "$ui" "$head"; st_rc "ui gate with an unknown tree state" 1; st_out_has "ui gate with an unknown tree state" "dirty tree"
  # tf_ui_gate on top of it: the die message, the flaky line, and the override.
  st_result "$ui" null 0 "$head" true 0 '["HistoryUITests/a()"]'
  st_run tf_ui_gate "$ui" "$head"; st_rc "tf_ui_gate with a passing run" 0; st_out_has "tf_ui_gate flaky line" "dev: testflight: the full ui-test's flaky tests: HistoryUITests/a()"
  st_run tf_ui_gate "$ui" 3333333333333333333333333333333333333333; st_rc "tf_ui_gate with another HEAD" 1
  st_out_has "tf_ui_gate message" "refusing to upload: run ./dev ui-test on this commit first (full suite, clean tree; the last run was on commit 1111111, HEAD: 3333333333333333333333333333333333333333). DEV_SKIP_UI_GATE=1 overrides."
  DEV_SKIP_UI_GATE=1 st_run tf_ui_gate "$ST_DIR/none.json" "$head"; st_rc "tf_ui_gate with the override" 0; st_out_has "tf_ui_gate override" "WARNING: DEV_SKIP_UI_GATE=1"

  local nl=$'\n' tab=$'\t'
  # ck-schema field diff: two .ckdb fixtures in cktool's export format (RECORD TYPE <name> ( <field> <TYPE> [modifiers], …
  # GRANT … );), Production missing one field, with another retyped and another present only there.
  mkdir -p "$ST_DIR/ck"
  cat >"$ST_DIR/ck/dev.ckdb" <<'CKDB'
DEFINE SCHEMA

    RECORD TYPE CD_Exercise (
        CD_name                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_restSeconds          INT64 QUERYABLE SORTABLE,
        CD_unit                 BYTES QUERYABLE SORTABLE,
        "___etag"               STRING,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Template (
        CD_name                 STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_OnlyDev (
        CD_x                    STRING,
        GRANT READ TO "_world"
    );
CKDB
  sed -e '/CD_unit /d' -e 's/CD_restSeconds          INT64/CD_restSeconds          STRING/' -e '/RECORD TYPE CD_OnlyDev/,/);/d' \
    -e 's/^        CD_name                 STRING QUERYABLE SEARCHABLE SORTABLE,$/&\n        CD_extra                STRING,/' "$ST_DIR/ck/dev.ckdb" >"$ST_DIR/ck/prod.ckdb"
  st_eq "ck_fields lists type, field and field type" "CD_Exercise CD_name STRING${nl}CD_Exercise CD_restSeconds INT64${nl}CD_Exercise CD_unit BYTES${nl}CD_Exercise ___etag STRING${nl}CD_Template CD_name STRING${nl}CD_OnlyDev CD_x STRING" "$(ck_fields "$ST_DIR/ck/dev.ckdb")"
  st_run ck_fields_diff "$ST_DIR/ck/dev.ckdb" "$ST_DIR/ck/prod.ckdb"; st_rc "ck_fields_diff with a missing, a retyped and an extra field" 1
  st_out_has "ck_fields_diff names the missing field" "production lacks field CD_Exercise.CD_unit (BYTES)"
  st_out_has "ck_fields_diff names the retyped field" "field CD_Exercise.CD_restSeconds is INT64 in development but STRING in production"
  st_out_has "ck_fields_diff names the extra field" "production has field CD_Exercise.CD_extra (STRING) that development lacks"
  st_out_lacks "ck_fields_diff leaves a record type Production lacks to the type check" "CD_OnlyDev"
  st_run ck_fields_diff "$ST_DIR/ck/dev.ckdb" "$ST_DIR/ck/dev.ckdb"; st_rc "ck_fields_diff on identical exports" 0
  st_eq "ck_fields_diff on identical exports is silent" "" "$ST_OUT"
  sed '/CD_unit /d' "$ST_DIR/ck/dev.ckdb" >"$ST_DIR/ck/prod-one.ckdb"
  st_run ck_fields_diff "$ST_DIR/ck/dev.ckdb" "$ST_DIR/ck/prod-one.ckdb"; st_rc "ck_fields_diff with one missing field" 1
  st_eq "ck_fields_diff with one missing field names only it" "ck-schema: production lacks field CD_Exercise.CD_unit (BYTES)" "$ST_OUT"
  st_run cmd_ck_schema fields "$ST_DIR/ck/prod-one.ckdb"; st_rc "ck-schema fields" 0
  st_out_has "ck-schema fields prints type field type" "CD_Template CD_name STRING"
  st_run cmd_ck_schema fields "$ST_DIR/ck/missing.ckdb"; st_rc "ck-schema fields on a missing file" 1

  echo "selftest: $ST_PASS passed, $ST_FAIL failed"
  ((ST_FAIL == 0))
}

# lint and kit need no simulator, so they run first; `test` builds the app (build-for-testing) and waits its turn in simkit's queue.
cmd_check() {
  cmd_lint || return
  cmd_kit || return
  cmd_test || return
  # The PreToolUse hook that gates `git commit` compares this stamp's mtime against changed files.
  mkdir -p .build && touch .build/check.stamp
  echo "check: ok"
}

cmd_help() {
  cat <<'USAGE'
Simulator verbs run through simkit ($SIMKIT_HOME/bin/sim, default ~/Projects/simkit; its AGENTS.md "The loop" is the manual).
A verb marked (leased) takes this worktree's session lease first (idempotent); ./dev release ends it, and simkit drops it after
ten minutes with no verb. test, ui-test, tree, shot and poses are whole jobs: they use the session lease when one is held, else
queue for one of their own. Exit 75 = the queue says wait; never retry in a loop. Workers, retries, skips and the Health suite
are in simkit.json.
build              build the app (no lease, nothing booted)
run [-- args]      (leased) build, install, launch; args go to the app (-- -preview <Name>)
test [filter]      WorkoutsTests on the simulator (filter = Suite or Suite/test()); one totals line, fails if none ran; SNAPSHOT_RECORD=1 re-records the snapshots
ui-test [filter]   WorkoutsUITests; no filter = the full suite as one job; filter HealthKitIntegration... = the real-Health run; DEV_POSE=<pose> poses the Duo (filtered runs)
tree <Name>        accessibility tree of the `-preview <Name>` screen via TreeDumpUITests
ui-status          where the running ui-test stands, else the last run's final line
ui-flaky [--since <days>]  tests that failed, then passed on retry
coverage [test|ui-test]    per-target coverage of the last passing run
shot [--burst [CxMS]] <png> [-- args]  run + settled screenshot; --burst = the first frames as one PNG grid (default 15x100)
poses <dir> [-- args]      run, then the four Duo poses as PNGs <dir>/<pose>.png
pose <name> [png]  (leased) closed-portrait|closed-landscape|open-wide|open-tall, verified
fold <x> [png]     (leased) closed|half-open|open; fold --keyframes '<json>' [--record <mov> [--display lit|outer|inner]]
orient <o> [png]   (leased) portrait|landscape-left|landscape-right
screenshot [path]  (leased) picture of the simulator (default .build/screenshots/<timestamp>.png; DEV_DISPLAY=<display>)
home [png]         (leased) the Home screen
duo <verb> [args]  (leased) simkit's panels|screenshot|settle|hinge|fold|orient|pose|home; `hinge --app` gets --subsystem
ui-env [content_size <size>] [appearance light|dark] | reset   (leased) text size / appearance of the simulator
probe [dir]        (leased) launch with -uiTesting, then answer sim/probes.json into <dir> (default .build/probe)
sims               the pool: slots, who holds which simulator, who waits (sim status)
release            end this session's simulator lease
kit [filter]       swift test in Packages/WorkoutsKit; prints summary line, fails if filter matched nothing
kit-coverage       swift test with coverage; prints the whole-package line coverage (llvm-cov TOTAL)
kit-build          swift build in Packages/WorkoutsKit
thumb-crops        regenerate Resources/Library/thumbs/thumb-crops.json (per-exercise figure crop rectangle, from Tools/thumb-crops.swift); deterministic, run by hand and commit the result
lint               swift-format lint --strict
format             swift-format in place
testflight [--upload]  signed App Store archive + export to .build/testflight/export (no upload unless --upload;
                   --upload reads two result.json files (.build/simkit/test/WorkoutsUITests/ and .../WorkoutsUITests-health/) and refuses
                   unless the full ./dev ui-test passed on HEAD with a clean tree, DEV_SKIP_UI_GATE=1 skips, and unless the Health code
                   (Workouts/Features/Health, the kit's Health directory, entitlements, HealthKitIntegrationUITests) is unchanged in the
                   working tree since the last passing real-Health run (clean tree, nothing skipped), DEV_SKIP_HEALTH_GATE=1 skips that one);
                   key from 1Password via op, build number = UTC yyyymmddHHMM; no simulator
media-upload [--env development|production] [--limit N] [--only <sourceId>]
                   upload exercise videos to CloudKit's public database (Web Services, server-to-server key via op);
                   re-runs skip records that already hold both assets; no simulator
ck-schema export [--env development|production] | diff | fields <ckdb file>
                   CloudKit schema via cktool, management token from 1Password via op run: export writes .build/cloudkit/schema-<env>.ckdb
                   and lists its record types; diff exports both and names the record types Production still lacks and, per shared record
                   type, the fields (type.field) added, removed or retyped between Development and Production (exit 1 until the
                   Console's Deploy Schema Changes… has run: cktool cannot write to Production); fields prints `type field type` lines of
                   a .ckdb file offline (no token); no simulator
clean              rm -rf .build
check             lint, kit, test; stops at first failure; on success touches .build/check.stamp and prints `check: ok`
selftest           the upload gates (on result.json fixtures), the swift test totals and the ck-schema logic, on fixture files in a temp dir; no simulator, not part of check
help               this list
USAGE
}

sub="${1:-help}"
[[ $# -gt 0 ]] && shift
case "$sub" in
  build) cmd_build ;;
  run) cmd_run "$@" ;;
  test) cmd_test "$@" ;;
  ui-test) cmd_ui_test "$@" ;;
  tree) cmd_tree "$@" ;;
  ui-status) cmd_ui_status ;;
  ui-flaky) cmd_ui_flaky "$@" ;;
  coverage) cmd_coverage "$@" ;;
  shot) cmd_shot "$@" ;;
  poses) cmd_poses "$@" ;;
  pose) cmd_pose "$@" ;;
  fold) cmd_fold "$@" ;;
  orient) cmd_orient "$@" ;;
  screenshot) cmd_screenshot "$@" ;;
  home) cmd_home "$@" ;;
  duo) cmd_duo "$@" ;;
  ui-env) cmd_ui_env "$@" ;;
  probe) cmd_probe "$@" ;;
  sims) cmd_sims ;;
  release) cmd_release ;;
  kit) cmd_kit "$@" ;;
  kit-build) cmd_kit_build ;;
  kit-coverage) cmd_kit_coverage ;;
  thumb-crops) cmd_thumb_crops ;;
  lint) cmd_lint ;;
  format) cmd_format ;;
  testflight) cmd_testflight "$@" ;;
  media-upload) cmd_media_upload "$@" ;;
  ck-schema) cmd_ck_schema "$@" ;;
  selftest) cmd_selftest ;;
  clean) cmd_clean ;;
  check) cmd_check ;;
  help | -h | --help) cmd_help ;;
  *) cmd_help >&2; die "unknown command: $sub" ;;
esac
