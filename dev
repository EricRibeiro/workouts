sims [--prune]     create the missing simulator clones (iPhone Duo 2..$DEV_SIM_POOL, default 5) and list the pool; --prune also shuts down idle pool sims and erases clones with PosterKit build-up
                   (simulator commands use this checkout's own simulator, kept in .build/dev-sim-udid; DEV_SIM=<name>
                   or DEV_SIM_UDID=<udid> overrides)
build              build the app for this checkout's simulator
test [filter]      run WorkoutsTests (filter = suite or suite/test); prints totals, fails if none ran
ui-test [filter]   run WorkoutsUITests (an unfiltered pass is sharded over DEV_UI_SHARDS pool sims and stamps HEAD, with its flaky tests, for the testflight --upload gate); prints totals, fails if none ran (filter HealthKitIntegrationUITests opts in to the real-Health test)
tree <Name>        print the accessibility tree (XCUIApplication.debugDescription) of the `-preview <Name>` screen via TreeDumpUITests; no private AX bridge
ui-status          progress of a running ui-test (one line per shard: passed/total, failures, last test, elapsed), else the last stamp and the last run's final line (.build/ui-test.progress)
coverage [test|ui-test]  per-target code coverage of the last passing test (default) or ui-test run (xccov); fails if none kept
kit [filter]       swift test in Packages/WorkoutsKit; prints summary line, fails if filter matched nothing
kit-coverage       swift test with coverage; prints the whole-package line coverage (llvm-cov TOTAL)
kit-build          swift build in Packages/WorkoutsKit
lint               swift-format lint --strict
format             swift-format in place
run [-- args]      boot sim, build, install, launch; args go to the app (-- -preview <Name>); prints log command
shot <png> [-- args]  run + settle (identical consecutive captures) + screenshot in one lock hold (use this for proofs; parallel-safe)
shot --burst [<count>x<intervalMs>] <png> [-- args]  launch and capture the lit panel from the first moment (default 15x100), tiled into one
                   labelled PNG grid: a reviewer artifact for transitions, not a settled proof (no tap injection)
screenshot [path]  simulator screenshot (default .build/screenshots/<timestamp>.png)
home [png]         go to the Home screen (the app keeps running in the background); png = capture of it
fold <pose> [png]  Duo hinge: closed|half-open|open, verified by hinge reads and the lit panel; png = capture of the lit panel
fold --keyframes '<json>' [--record <mov> [--display lit|outer|inner]]  timed hinge motion: [{"atMs":0,"angle":0},{"atMs":3000,"angle":180}] (2-64 keyframes, <= 60 s,
                   linear, 60 Hz on absolute deadlines), final pose verified like fold; --record = simctl io recordVideo around it (one panel, default the lit one). Leave the sim closed
orient <o> [png]   portrait|landscape-left|landscape-right, verified by devicectl orientation and the lit panel; png as for fold
pose <name> [png]  Duo layout in one verified step: closed-portrait|closed-landscape|open-wide (951x669 pt)|open-tall (669x951 pt);
                   the png is a settled capture (two identical consecutive captures, 10 s timeout)
poses <dir> [-- args]  run (install + launch with args) then all four poses as settled PNGs <dir>/closed-portrait.png … open-tall.png,
                   under one simulator lock with the status bar pinned; always ends closed-portrait, also after a failure midway
duo <verb> [args]  Tools/duo pass-through (panels, hinge, settle [--timeout s], screenshot [--display lit|outer|inner] [--settle | --burst [CxMS]], fold <degrees>, guest-build,
                   --help); adds --udid for this checkout's simulator when the verb needs one; built into .build/duo/spm
duo-test           swift test for Tools/duo (host-only, ~1s); also part of check
testflight [--upload]  signed App Store archive + export to .build/testflight/export (no upload unless --upload;
                   --upload refuses unless a full ./dev ui-test passed on HEAD with a clean tree, DEV_SKIP_UI_GATE=1 skips);
                   key from 1Password via op, build number = UTC yyyymmddHHMM; no simulator lock
media-upload [--env development|production] [--limit N] [--only <sourceId>]
                   upload exercise videos to CloudKit's public database (Web Services, server-to-server key via op);
                   re-runs skip records that already hold both assets; no simulator lock
clean              rm -rf .build
check             lint, kit, duo-test, build, test; stops at first failure; on success touches .build/check.stamp
help               this list
USAGE
}

sub="${1:-help}"
[[ $# -gt 0 ]] && shift
case "$sub" in
  build) cmd_build ;;
  test) sim_guarded cmd_test "$@" ;;
  ui-test) sim_guarded cmd_ui_test "$@" ;;
  ui-status) cmd_ui_status ;;
  tree) sim_guarded cmd_tree "$@" ;;
  kit) cmd_kit "$@" ;;
  kit-build) cmd_kit_build ;;
  kit-coverage) cmd_kit_coverage ;;
  coverage) cmd_coverage "$@" ;;
  lint) cmd_lint ;;
  format) cmd_format ;;
  run) sim_guarded cmd_run "$@" ;;
  screenshot) sim_guarded cmd_screenshot "$@" ;;
  shot) sim_guarded cmd_shot "$@" ;;
  home) sim_guarded cmd_home "$@" ;;
  fold) sim_guarded cmd_fold "$@" ;;
  orient) sim_guarded cmd_orient "$@" ;;
  pose) sim_guarded cmd_pose "$@" ;;
  poses) sim_guarded cmd_poses "$@" ;;
  duo) case "${1:-}" in panels | screenshot | settle | hinge | fold | orient | pose | poses | home) sim_guarded cmd_duo "$@" ;; *) cmd_duo "$@" ;; esac ;;
  duo-test) cmd_duo_test ;;
  sims) cmd_sims "$@" ;;
  testflight) cmd_testflight "$@" ;;
  media-upload) cmd_media_upload "$@" ;;
  clean) cmd_clean ;;
  check) sim_guarded cmd_check ;;
  help | -h | --help) cmd_help ;;
  *) cmd_help >&2; die "unknown command: $sub" ;;
esac
